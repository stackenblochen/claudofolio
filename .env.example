# Copy the lines you need into .env (git-ignored). Never commit real values.
CASE_STUDY_PASSWORD=
# FTP upload to hallo-wl.de (npm run deploy)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_DIR=/
# FTP_SECURE=true          # true (explicit FTPS, default) | false (plain FTP) | implicit
# FTP_PORT=
# FTP_INSECURE_TLS=false   # true only if the host's TLS certificate does not match the host name
# Umami analytics (live build only). Website ID from the Umami dashboard; script URL only if self-hosted.
UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
