---
/** Base layout: <html>, fonts, tokens, SEO, header, footer. Every page uses this. */
import '@fontsource-variable/geist';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import LoadingBar from '../components/LoadingBar.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE, url } from '../lib/site';
import { gradientCss } from '../lib/gradients';

interface Props {
  /** Page name. Rendered as "{title} — Wolfgang Lattermann". Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or base-prefixed URL of the Open Graph image. Defaults to the logo type (public/og-default.png). */
  ogImage?: string;
  noindex?: boolean;
  /** Label of the active nav item. */
  current?: string;
  /** Background context: grouped (default, gray base, white cards) or standard (white / black base, gray cards). */
  context?: 'grouped' | 'standard';
}
// Page transition: old page fades out, then the new page fades in (keyframes in base.css).
const pageFade = {
  forwards: {
    old: { name: 'pt-fade-out', duration: '0.2s', easing: 'ease-in', fillMode: 'forwards' },
    new: { name: 'pt-fade-in', duration: '0.3s', delay: '0.2s', easing: 'ease-out', fillMode: 'backwards' },
  },
  backwards: {
    old: { name: 'pt-fade-out', duration: '0.2s', easing: 'ease-in', fillMode: 'forwards' },
    new: { name: 'pt-fade-in', duration: '0.3s', delay: '0.2s', easing: 'ease-out', fillMode: 'backwards' },
  },
};
const { title, description = SITE.description, ogImage, noindex: noindexProp = false, current, context = 'grouped' } = Astro.props;
// Everything except the production release (SITE_TARGET=production, hallo-wl.de) is a staging copy: keep it out of search engines and AI training.
const noindex = noindexProp || process.env.SITE_TARGET !== 'production';
// Umami analytics (cookieless): only in the production release and only when UMAMI_WEBSITE_ID is set at build time. It follows ClientRouter navigations by itself.
const umamiId = process.env.SITE_TARGET === 'production' ? process.env.UMAMI_WEBSITE_ID : undefined;
const umamiSrc = process.env.UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js';
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Telma Bold (700, upright; Fontshare, free licence; size-adjust 110% so it matches the Clash Display headline): the face of the highlighted words.
const telma = [['900','Black'],['700','Bold'],['500','Medium'],['300','Light']].map(([n, l]) => `@font-face{font-family:'Telma';font-weight:${n};font-style:normal;font-display:swap;size-adjust:110%;src:url('${url(`/fonts/Telma-${l}.woff2`)}') format('woff2')}`).join('');
// Clash Display Semibold (600, headlines); Regular (400), Fontshare, free licence; Medium (500) and Bold (700) stay declared for a quick switch.
const clash = ['400:Regular','500:Medium','600:Semibold','700:Bold'].map((w) => { const [n, l] = w.split(':'); return `@font-face{font-family:'Clash Display';font-weight:${n};font-style:normal;font-display:swap;size-adjust:108%;src:url('${url(`/fonts/ClashDisplay-${l}.woff2`)}') format('woff2')}`; }).join('');
---

<!doctype html>
<html lang="en" data-context={context === 'standard' ? 'standard' : undefined} transition:animate={pageFade}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0d12" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon-light.png')} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon-dark.png')} media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive, noimageai, noai" />}
    {noindex && <meta name="googlebot" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage ?? url('/og-default.png'), Astro.site)} />
    <meta property="og:image:width" content={ogImage ? undefined : '1200'} />
    <meta property="og:image:height" content={ogImage ? undefined : '630'} />
    <meta name="twitter:card" content="summary_large_image" />
    <style set:html={telma} />
    <style set:html={clash} />
    <style is:global set:html={gradientCss()} /> <!-- gradient tokens + .gradient classes, see src/lib/gradients.ts -->
    <script is:inline>
      // Runs before first paint: .js flag + theme. Dark is the default; "light" is the only stored value.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        function theme() {
          var t = 'dark';
          try { if (localStorage.getItem('theme') === 'light') t = 'light'; } catch (e) {}
          root.dataset.theme = t;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#f5f5f7' : '#0d0d12');
        }
        theme();
        // View transitions replace the <html> attributes: re-apply after every swap.
        document.addEventListener('astro:after-swap', theme);
      })();
    </script>
    <ClientRouter />
    {umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
  </head>
  <body>
    <LoadingBar />
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main"><slot /></main>
    <SiteFooter />
    <BackToTop />
    <script>
      // Keep the .js flag on the swapped <html> so .reveal elements do not flash visible.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));

      // Scroll reveal: scale + opacity. CSS neutralises it for reduced motion.
      document.addEventListener('astro:page-load', () => {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      });
    </script>
  </body>
</html>
