---
/**
 * Case-study layout: hero → overview (with role, team, timeline) → [MDX: numbered StorySections, the last one the Outcome (`closing`), optional ScreenGallery] → other projects.
 * Hero and Overview come from the frontmatter (title, labels, lead, role/team/timeline); the MDX body holds the numbered sections, the Outcome included.
 */
import Base from './Base.astro';
import Protected from '../components/Protected.astro';
import CaseHero from '../components/CaseHero.astro';
import Overview from '../components/Overview.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects, toCard, type ProjectEntry } from '../lib/projects';
import { plain } from '../lib/site';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const d = project.data;

const meta = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Timeline', value: d.timeline },
  { label: 'Platforms', value: d.platforms?.join(', ') },
].filter((i): i is { label: string; value: string } => !!i.value);
const others = (await getProjects({ exclude: project.id, limit: 2 })).map(toCard);
---

<Base title={d.shortTitle} description={d.summary} ogImage={d.cover.src}>
  <Protected enabled={d.protected} title={plain(d.title)}>
    <CaseHero
      title={d.title}
      labels={d.labels}
      variant={d.heroVariant}
      image={d.cover}
      imageAlt={d.coverAlt}
      background={d.heroBackground}
      confidential={d.confidential}
    />
    <Overview sentences={d.lead} meta={meta.length >= 3 ? meta : []} />
    <div class="stories"><slot /></div>
    {others.length > 0 && (
      <section class="others section section--pure" aria-labelledby="others-title">
        <SectionTitle id="others-title" chapter>Other projects</SectionTitle>
        <div class="container grid-wrap"><ProjectGrid items={others} /></div>
      </section>
    )}
  </Protected>
</Base>

<style>
  .stories { display: flex; flex-direction: column; }
  .stories :global(> section) { padding-block: var(--chapter-gap) 0; }
  .stories { padding-bottom: var(--chapter-gap); }
  .others { padding-top: 0; }
  .grid-wrap { margin-top: var(--space-6); }
</style>
