---
import { render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import { getProjects } from '../../lib/projects';
import StorySection from '../../components/StorySection.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import Figure from '../../components/Figure.astro';
import Comparison from '../../components/Comparison.astro';
import ImageText from '../../components/ImageText.astro';
import Video from '../../components/Video.astro';
import Embed from '../../components/Embed.astro';
import Arrow from '../../components/Arrow.astro';
import Mock from '../../components/Mock.astro';
import Schema from '../../components/Schema.astro';
import Diagram from '../../components/Diagram.astro';
import MediaText from '../../components/MediaText.astro';
import MediaRow from '../../components/MediaRow.astro';
import Quote from '../../components/Quote.astro';
import Principles from '../../components/Principles.astro';
import SchemaGroup from '../../components/schema/SchemaGroup.astro';
import SchemaPill from '../../components/schema/SchemaPill.astro';
import SchemaArrow from '../../components/schema/SchemaArrow.astro';
import SchemaList from '../../components/schema/SchemaList.astro';
import PositioningMap from '../../components/charts/PositioningMap.astro';
import SpectrumStrips from '../../components/charts/SpectrumStrips.astro';

export async function getStaticPaths() {
  const projects = await getProjects({ includeUnlisted: true });
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Available in every case-study MDX without imports.
const components = { StorySection, ScreenGallery, Figure, Comparison, ImageText, Video, Embed, Arrow, Mock, Diagram, MediaText, MediaRow, Quote, Principles, Schema, SchemaGroup, SchemaPill, SchemaArrow, SchemaList, PositioningMap, SpectrumStrips };
---

<CaseStudy project={project}>
  <Content components={components} />
</CaseStudy>
