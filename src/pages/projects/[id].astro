---
import { render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import { getProjects } from '../../lib/projects';
import Chapter from '../../components/Chapter.astro';
import SubChapter from '../../components/SubChapter.astro';
import ChallengeSolution from '../../components/ChallengeSolution.astro';
import Figure from '../../components/Figure.astro';
import FigurePair from '../../components/FigurePair.astro';
import ScreenStack from '../../components/ScreenStack.astro';
import Comparison from '../../components/Comparison.astro';
import InsightRow from '../../components/InsightRow.astro';
import Video from '../../components/Video.astro';
import Embed from '../../components/Embed.astro';
import Arrow from '../../components/Arrow.astro';
import Mock from '../../components/Mock.astro';
import Schema from '../../components/Schema.astro';
import SchemaGroup from '../../components/schema/SchemaGroup.astro';
import SchemaPill from '../../components/schema/SchemaPill.astro';
import SchemaArrow from '../../components/schema/SchemaArrow.astro';
import SchemaList from '../../components/schema/SchemaList.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Available in every case-study MDX without imports.
const components = { Chapter, SubChapter, ChallengeSolution, Figure, FigurePair, ScreenStack, Comparison, InsightRow, Video, Embed, Arrow, Mock, Schema, SchemaGroup, SchemaPill, SchemaArrow, SchemaList };
---

<CaseStudy project={project}>
  <Content components={components} />
</CaseStudy>
