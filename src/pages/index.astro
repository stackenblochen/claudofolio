---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects, toCard } from '../lib/projects';

const projects = (await getProjects()).map(toCard);
---

<Base description="Wolfgang Lattermann is a product designer based in Berlin. Selected work in product design and design systems.">
  <HomeHero>
    <Fragment slot="intro">Hi, I’m <em>Wolfgang</em>,<br class="br-md" /> a product designer<br class="br-md" /> based in Berlin.</Fragment>
    <Fragment slot="subline">Making complex things simple,<br class="br-md" /> with an eye on what they could become.</Fragment>
  </HomeHero>


  <section class="work section section--pure" aria-labelledby="work">
    <SectionTitle id="work" dash>Selected work</SectionTitle>
    <div class="container grid-wrap"><ProjectGrid items={projects} /></div>
  </section>
</Base>

<style>
  .work { padding-top: 0; scroll-margin-top: var(--header-h); }
  .grid-wrap { margin-top: var(--space-7); }
</style>
