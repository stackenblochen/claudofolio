---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import AboutIntro from '../components/AboutIntro.astro';
import AboutSections from '../components/AboutSections.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { url } from '../lib/site';
import { getTeasers } from '../lib/projects';

const projects = await getTeasers();
---

<Base description="Wolfgang Lattermann is a product designer based in Berlin. Selected work, experience and career in product design and design systems.">
  <HomeHero>
    <Fragment slot="actions">
      <a class="btn t-label" href="#selected-work">View work</a>
      <a class="btn t-label" href="#about">About me</a>
    </Fragment>
  </HomeHero>


  <section id="selected-work" class="work section section--pure" aria-labelledby="work">
    <SectionTitle id="work" chapter>Selected work</SectionTitle>
    <div class="container grid-wrap"><ProjectGrid items={projects} /></div>
  </section>

  <section id="about" class="work section section--pure" aria-labelledby="about-title">
    <AboutIntro />
  </section>

  <section class="work section section--pure">
    <AboutSections />
  </section>

  <section class="work section section--pure">
    <ContactBlock />
  </section>
</Base>

<style>
  .work { padding-top: 0; /* the "View work" button lands here: the section starts a chapter gap above the red dash, so pull the target down to leave the dash and headline clear of the header */
    scroll-margin-top: calc(var(--header-h) + var(--space-6) - var(--chapter-gap)); }
  .grid-wrap { margin-top: var(--space-6); }
</style>
