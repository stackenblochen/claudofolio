---
/** The About content now lives on the home page (#about). This old address forwards there, so existing links keep working. */
import { url } from '../lib/site';
const target = url('/#about');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>About me</title>
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body><a href={target}>About me</a></body>
</html>
