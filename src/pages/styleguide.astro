  .col { grid-column: span 1 !important; height: 64px; background: color-mix(in srgb, var(--accent-primary) 18%, transparent); border-inline: 1px solid color-mix(in srgb, var(--accent-primary) 50%, transparent);
    display: grid; place-items: center; color: var(--accent-primary); font-size: var(--text-label-size); }
  .bars { display: flex; flex-direction: column; gap: var(--space-2); }
  .bar-row { background: var(--fill); padding: var(--space-2) var(--space-3); color: var(--text-strong); border-radius: 4px; }
  .matrix { border-collapse: collapse; }
  .matrix th, .matrix td { text-align: left; padding: var(--space-2) var(--space-3) var(--space-2) 0; border-bottom: 1px solid var(--border); }
  .matrix th { color: var(--text-default); font-weight: 400; }
  .intro-note { padding-top: var(--space-5); }
  /* semantic roles: a real grid, one ruled row per role, columns aligned */
  .colors { padding-top: var(--space-5); }
  .crow { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 1.05fr) minmax(0, 1.05fr); column-gap: var(--space-4); align-items: center; padding-block: var(--space-3); border-bottom: 1px solid var(--border); }
  .chead { color: var(--text-default); padding-block: var(--space-2); }
  .cgroup { color: var(--text-strong); padding-top: var(--space-6); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border); }
  .cell { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
  .hex { text-transform: uppercase; }
  .ctoken, .chex { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ctoken code, .chex code { overflow-wrap: anywhere; }
  .ctoken code { color: var(--text-strong); }
  .cuse, .cvar { color: var(--text-default); }
  .chip { width: 32px; height: 32px; flex: none; border-radius: var(--radius-m); border: 1px solid var(--border); }
  @media (max-width: 767px) {
    .crow { grid-template-columns: 1fr 1fr; row-gap: var(--space-2); }
    .crow > :nth-child(1), .crow > :nth-child(2) { grid-column: 1 / -1; }
    .chead { display: none; }
  }
  .ramp { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); padding-block: var(--space-5); }
  @media (min-width: 768px) { .ramp { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .rstep { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .ramp--accent { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 768px) { .ramp--accent { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .rchip { height: 72px; border-radius: var(--radius-m); border: 1px solid var(--border); display: block; }
  .rstep figcaption { color: var(--text-default); display: flex; flex-direction: column; gap: 2px; }
  .rstep .gname { color: var(--text-strong); }
  .rstep code { text-transform: uppercase; }
  .gradients { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-5); padding-top: var(--space-5); }
  .gswatch { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .gfield { aspect-ratio: 16 / 10; border-radius: var(--radius-l); display: grid; place-items: center; padding: var(--space-4); text-align: center;
    background: linear-gradient(180deg, var(--g-top), var(--g-bottom)); }
  .gdefault { background: linear-gradient(180deg, var(--gradient-hero-top), var(--gradient-hero-bottom)); }
  .ghead { margin-top: var(--space-7); display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
  .gnote { color: var(--text-default); }
  .gmatrix { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  @media (min-width: 768px) { .gmatrix { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
