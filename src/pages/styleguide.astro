</style>

<script>
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    const root = document.querySelector<HTMLElement>('[data-grid-demo]');
    if (!root) return;
    ac = new AbortController();
    const cs = getComputedStyle(document.documentElement);
    const update = () => {
      const c = root.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(root).paddingLeft);
      const gutter = parseFloat(cs.getPropertyValue('--gutter'));
      const w = c.width - pad * 2;
      const col = (w - 11 * gutter) / 12;
      const t = cs.getPropertyValue('--measure-text-cols').trim();
      const m = cs.getPropertyValue('--measure-media-cols').trim();
      root.querySelector('[data-label="text"]')!.textContent = `Text: ${t} columns`;
      root.querySelector('[data-label="media"]')!.textContent = `Media: ${m} columns`;
      root.querySelector('[data-readout]')!.textContent =
        `viewport ${innerWidth}px · outer ${Math.round(c.width)}px · padding ${pad}px · grid ${Math.round(w)}px · gutter ${gutter}px · column ${col.toFixed(1)}px`;
    };
    update();
    window.addEventListener('resize', update, { signal: ac.signal });
  });
</script>
