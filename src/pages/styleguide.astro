  .matrix th { color: var(--text-default); font-weight: 400; }
  .intro-note { padding-top: var(--space-5); }
  .colors { display: grid; gap: var(--space-3); padding-top: var(--space-5); }
  .crow { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: var(--space-4); align-items: center; }
  .chead { color: var(--text-default); }
  .cell { display: flex; align-items: center; gap: var(--space-3); }
  .hex { text-transform: uppercase; }
  .ctoken, .chex { display: flex; flex-direction: column; gap: 2px; }
  .ctoken code { color: var(--text-strong); }
  .cuse, .cvar { color: var(--text-default); }
  .chip { width: 44px; height: 44px; flex: none; border-radius: var(--radius-m); border: 1px solid var(--border-subtle); }
  @media (max-width: 767px) { .crow { grid-template-columns: 1fr 1fr; } .crow > :first-child { grid-column: 1 / -1; } .chead { display: none; } }
  .ramp { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); padding-block: var(--space-5); }
  @media (min-width: 768px) { .ramp { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .rstep { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .rchip { height: 72px; border-radius: var(--radius-m); border: 1px solid var(--border-subtle); display: block; }
  .rstep figcaption { color: var(--text-default); display: flex; flex-direction: column; gap: 2px; }
  .rstep .gname { color: var(--text-strong); }
  .rstep code { text-transform: uppercase; }
  .gradients { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-5); padding-top: var(--space-5); }
  .gswatch { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .gfield { aspect-ratio: 16 / 10; border-radius: var(--radius-l); display: grid; place-items: center; padding: var(--space-4); text-align: center;
    background: linear-gradient(180deg, var(--g-top), var(--g-bottom)); }
  .gdefault { background: linear-gradient(180deg, var(--gradient-hero-top), var(--gradient-hero-bottom)); }
