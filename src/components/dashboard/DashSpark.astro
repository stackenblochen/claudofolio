---
/**
 * Chart in a card (edge-padded, pinned to the card bottom by the card). `mode`: "line" | "area" (tinted, stepped) | "bars" (outlined bars).
 * `step`: a line drawn as steps. `tone`: "blue" (default) | "green" (on track) | "red" (off track). `goal`: the target, a grey line across the chart; with it a dashed projection runs from the last value to `forecast`
 * (default: the goal) and ends in a dot. Draw the forecast as the continuation of the trend, so it never contradicts the history; `span` = share of the width the real series fills when there is a goal (default 0.72).
 * `ticks` = x labels (with a small tick under the axis), spread evenly or at `tickAt` (0–1 along the axis, for real dates);
 * `now` = a dashed vertical line at the last real value (today), where the projection starts; `yLabels` = labels down the right edge, top to bottom; `unit` = small caption above;
 * `labels` = one name per value and `valueLabel` = the unit after the value, both for the hover tooltip.
 *
 *   <DashSpark alt="…" mode="area" values={[…]} unit="Person Weeks" ticks={['Mar', 'Jun']} yLabels={['60', '0']} />
 */
import './dashboard.css';
interface Props {
  alt: string; values: number[]; mode?: 'line' | 'area' | 'bars'; step?: boolean; tone?: 'blue' | 'green' | 'red'; goal?: number; forecast?: number; span?: number;
  ticks?: string[]; tickAt?: number[]; now?: boolean; yLabels?: string[]; unit?: string; height?: number; labels?: string[]; valueLabel?: string;
}
const { alt, values, mode = 'line', step = false, tone = 'blue', goal, forecast, span, ticks = [], tickAt, now, yLabels = [], unit, height = 76, labels = [], valueLabel = '' } = Astro.props;
const W = 360, H = height, PAD = 4, RIGHT = yLabels.length ? 34 : 4, B = ticks.length ? 20 : 6;
const ih = H - PAD - B, iw = W - PAD - RIGHT;
const end = forecast ?? goal; // where the dashed projection ends
const all = goal != null ? [...values, goal, ...(end != null ? [end] : [])] : values;
const lo = mode === 'bars' || mode === 'area' ? 0 : Math.min(...all), hi = Math.max(...all);
const range = hi - lo || 1;
const n = values.length;
const share = goal != null ? span ?? 0.72 : 1;
const stepX = (iw * share) / (mode === 'bars' ? n : n - 1 || 1);
const x = (i: number) => PAD + i * stepX;
const y = (v: number) => PAD + ih - ((v - lo) / range) * ih;
const f = (v: number) => +v.toFixed(1);
const stepped = values.map((v, i) => `${i ? 'L' : 'M'}${f(x(i))} ${f(y(v))}${i < n - 1 ? ` L${f(x(i + 1))} ${f(y(v))}` : ''}`).join(' ');
const straight = values.map((v, i) => `${i ? 'L' : 'M'}${f(x(i))} ${f(y(v))}`).join(' ');
const d = mode === 'area' || step ? stepped : straight;
const bw = Math.max(2, stepX - 2);
const gx = PAD + iw;
const axisY = PAD + ih;
const tx = (i: number) => PAD + (tickAt ? tickAt[i] : i / Math.max(1, ticks.length - 1)) * iw;
const pts = values.map((v, i) => [f(mode === 'bars' ? x(i) + bw / 2 : x(i)), f(y(v)), labels[i] ?? `#${i + 1}`, v]);
---
<div class="dash dspark-wrap">
  {unit && <div class="dcard__unit">{unit}</div>}
  <div class="dcard__chart">
    <svg class:list={['dspark', `dspark--${tone}`]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt} data-pts={JSON.stringify(pts)} data-w={W} data-h={H} data-vl={valueLabel}>
      {goal != null && <line class="dspark__target" x1={PAD} x2={gx} y1={f(y(goal))} y2={f(y(goal))} />}
      {mode === 'area' && <path class="dspark__area" d={`${stepped} L${f(x(n - 1))} ${axisY} L${f(x(0))} ${axisY} Z`} />}
      {mode === 'bars'
        ? values.map((v, i) => <rect class="dspark__bar" data-i={i} x={f(x(i))} y={f(y(v))} width={f(bw)} height={f(axisY - y(v))} />)
        : <path class="dspark__line" d={d} />}
      <line class="dspark__axis" x1={PAD} x2={PAD + iw} y1={axisY} y2={axisY} />
      {goal != null && mode !== 'bars' && (
        <>
          <path class="dspark__goal" d={`M${f(x(n - 1))} ${f(y(values[n - 1]))} L${gx} ${f(y(end!))}`} />
          <circle class="dspark__dot" cx={gx} cy={f(y(end!))} r="4" />
        </>
      )}
      {now && <line class="dspark__now" x1={f(x(n - 1))} x2={f(x(n - 1))} y1={PAD} y2={axisY} />}
      {mode !== 'bars' && <line class="dspark__cursor" y1={PAD} y2={axisY} />}
      {mode !== 'bars' && <circle class="dspark__hover" r="4" />}
      {ticks.map((t, i) => <line class="dspark__axis" x1={f(tx(i))} x2={f(tx(i))} y1={axisY} y2={axisY + 3} />)}
      {ticks.map((t, i) => <text class="dspark__text" x={f(tx(i))} y={H - 4} text-anchor={tx(i) < PAD + 12 ? 'start' : tx(i) > PAD + iw - 12 ? 'end' : 'middle'}>{t}</text>)}
      {yLabels.map((t, i) => <text class="dspark__text" x={W} y={f(i === 0 ? PAD + 8 : i === yLabels.length - 1 ? axisY : PAD + 8 + ((axisY - PAD - 8) * i) / (yLabels.length - 1))} text-anchor="end">{t}</text>)}
    </svg>
    <div class="dtip" role="tooltip" hidden></div>
  </div>
</div>
