---
/**
 * I14 Quote: a big statement set in the page's own type (`.t-quote`), for the design vision statement, on a card (`--bg-secondary`). An optional
 * small label above the statement. `*word*` in the text becomes an Editorial New highlight (like in titles); a line break (`\n`) starts a new line.
 *
 *   <Quote label="Design vision statement" text={'Serious security made simple for everyone who depends on it.\nIntuitive, modern, and personal by design.'} />
 */
import { highlight } from '../lib/site';

interface Props { text: string; label?: string }
const { text, label } = Astro.props;
const html = highlight(text).replace(/\n/g, '<br>');
---

<figure class="quote measure-media reveal">
  {label && <p class="t-label label">{label}</p>}
  <blockquote class="t-quote" set:html={html} />
</figure>

<style>
  .quote { margin-block: 0; display: flex; flex-direction: column; gap: var(--space-3); background: var(--bg-secondary); border-radius: var(--radius-l); padding: var(--space-5); }
  @media (min-width: 768px) { .quote { padding: var(--space-7) var(--space-8); } }
  .label { color: var(--text-default); }
  blockquote { margin: 0; }
</style>
