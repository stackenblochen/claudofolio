---
/** T1 Intro statement: 1–2 sentences in heading-l, on the raised background. */
---

<section class="section section--raised statement">
  <div class="container">
    <div class="measure-text reveal t-heading"><slot /></div>
  </div>
</section>

<style>
  .statement { padding-top: var(--space-6); padding-bottom: var(--space-9); }
  .statement :global(.t-heading) { font-weight: 400; }
</style>
