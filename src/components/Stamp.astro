---
/**
 * I8 "Confidential" stamp (src/assets/confidential.svg). Always used as delivered (white disc, black artwork),
 * in light and dark mode. The graphic carries the notice itself, so it gets an accessible name.
 */
import stamp from '../assets/confidential.svg';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<img src={stamp.src} width={stamp.width} height={stamp.height} class:list={['stamp-img', cls]}
  alt="Please keep all information shown here confidential. Do not share with others." />

<style>
  .stamp-img { display: block; height: auto; }
</style>
