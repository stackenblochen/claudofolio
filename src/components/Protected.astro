---
/**
 * Password gate for a case study. With `enabled` the slot is rendered to HTML at build time and encrypted
 * (AES-GCM, key from PBKDF2); the page only ships the ciphertext plus this form. The browser decrypts after
 * the right password is entered and remembers it for the tab (sessionStorage).
 * The password comes from CASE_STUDY_PASSWORD at build time (see src/lib/lock.ts).
 * Note: image and demo files are still reachable by URL; only the page content is encrypted.
 */
import { encryptHtml, getCasePassword } from '../lib/lock';

interface Props {
  enabled?: boolean;
  title: string;
}
const { enabled = false, title } = Astro.props;
const payload = enabled ? encryptHtml(await Astro.slots.render('default'), getCasePassword()) : null;
---

{enabled && payload
  ? (
    <div class="gate section" data-lock={JSON.stringify(payload)}>
      <div class="container"><form class="measure-text gate-form" novalidate>
        <h1 class="t-heading">{title}</h1>
        <p class="t-body">This case study is protected.<br /><span>To view it, please enter the password.</span></p>
        <div class="row">
          <label class="sr-only" for="case-password">Password</label>
          <div class="field">
            <input id="case-password" name="password" type="password" class="t-body" placeholder="Enter password" autocomplete="current-password" required />
            <button type="button" class="toggle" aria-label="Show password" aria-pressed="false" aria-controls="case-password">
              <svg class="eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
              <svg class="eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></svg>
            </button>
          </div>
          <button type="submit" class="submit t-label">Submit</button>
        </div>
        <p class="error t-label" role="alert" hidden>Wrong password, please try again.</p>
      </form></div>
    </div>
  )
  : <slot />}

<style>
  /* the locked view fills the space between header and footer, so the footer sits at the bottom of the viewport */
  :global(main:has(> .gate)) { display: flex; flex-direction: column; }
  :global(main:has(> .gate) + .site-footer) { margin-top: 0; }
  .gate { flex: 1 0 auto; display: grid; align-items: center; padding-bottom: var(--space-8); }
  .gate-form { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .lock { color: var(--text-strong); }
  .row { display: flex; gap: var(--space-2); width: 100%; }
  /* input spans 5 grid columns (of the text measure); the button sits next to it */
  .field { position: relative; flex: 0 1 calc((100% - (var(--measure-text-cols) - 1) * var(--gutter)) / var(--measure-text-cols) * 5 + 4 * var(--gutter)); min-width: 0; }
  @media (max-width: 767px) { .field { flex: 1; } }
  input { width: 100%; padding: var(--space-3) calc(var(--space-3) + 2.25rem) var(--space-3) var(--space-4); color: var(--text-strong); background: var(--bg-raised);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-m); font: inherit; transition: border-color 0.15s, box-shadow 0.15s; }
  input::placeholder { color: var(--text-default); opacity: 0.7; }
  input:focus-visible { outline: 0; border-color: var(--text-default); box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-default) 35%, transparent); }
  .toggle { position: absolute; top: 0; right: 0; height: 100%; aspect-ratio: 1; display: grid; place-items: center; padding: 0; cursor: pointer;
    color: var(--text-default); background: transparent; border: 0; border-radius: var(--radius-m); transition: color 0.15s, background-color 0.15s; }
  .toggle:hover { color: var(--text-strong); background: color-mix(in srgb, var(--text-strong) 8%, transparent); }
  .toggle:focus-visible { outline: 0; box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-default) 35%, transparent); }
  .toggle svg[hidden] { display: none; }
  .submit { cursor: pointer; padding: var(--space-3) var(--space-5); color: var(--text-strong); background: var(--bg-card); border: 0; border-radius: var(--radius-m); font: inherit; transition: color 0.15s, background-color 0.15s; }
  .submit:hover:not(:disabled) { color: var(--bg-page); background: var(--text-strong); }
  .submit:focus-visible { outline: 0; box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-default) 35%, transparent); }
  .submit:disabled { opacity: 0.6; cursor: progress; }
  .error { color: var(--accent-primary); }
</style>

<script>
  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  const KEY = 'case-password';

  async function decrypt(lock: { salt: string; iv: string; data: string; iterations: number }, password: string) {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: b64(lock.salt), iterations: lock.iterations, hash: 'SHA-256' },
      base, { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(lock.iv) }, key, b64(lock.data));
    return new TextDecoder().decode(plain);
  }

  function unlock(gate: HTMLElement, html: string) {
    const tpl = document.createElement('template');
    tpl.innerHTML = html;
    tpl.content.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    gate.replaceWith(tpl.content);
    window.scrollTo(0, 0);
    document.dispatchEvent(new Event('content-unlocked'));
  }

  document.addEventListener('astro:page-load', async () => {
    const gate = document.querySelector<HTMLElement>('.gate[data-lock]');
    if (!gate) return;
    const lock = JSON.parse(gate.dataset.lock!);
    const form = gate.querySelector('form')!;
    const input = form.querySelector('input')!;
    const error = form.querySelector<HTMLElement>('.error')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;

    const toggle = form.querySelector<HTMLButtonElement>('.toggle')!;
    toggle.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(show));
      toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      toggle.querySelector('.eye')!.toggleAttribute('hidden', show);
      toggle.querySelector('.eye-off')!.toggleAttribute('hidden', !show);
      input.focus();
    });

    let saved: string | null = null;
    try { saved = sessionStorage.getItem(KEY); } catch {}
    if (saved) {
      try { return unlock(gate, await decrypt(lock, saved)); } catch { try { sessionStorage.removeItem(KEY); } catch {} }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      button.disabled = true;
      try {
        const html = await decrypt(lock, input.value);
        try { sessionStorage.setItem(KEY, input.value); } catch {}
        unlock(gate, html);
      } catch {
        error.hidden = false;
        input.select();
        button.disabled = false;
      }
    });
  });
</script>
