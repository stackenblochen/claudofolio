---
/**
 * I5 Image + text row (insights, principles, any short finding with an illustration): text content, so it lives in the text measure (8 / 9 cols): illustration across 3 columns,
 * title + text across the rest (5 cols at xl), top aligned with the image. Stacked below 768 px. Repeat 3×.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  title: string;
  /** 1 px edge for a screenshot-like image whose edge would blur into the page: true = both themes, "dark-mode" / "light-mode" = only in that mode. */
  border?: boolean | 'dark-mode' | 'light-mode';
  /** Crop the image to a ratio (CSS aspect-ratio, e.g. '2000 / 1704'), so rows in a stack share one height. The crop is done in CSS, the file stays untouched. */
  ratio?: string;
  /** A white-only line drawing on a transparent background: sits on the secondary background and turns dark in light mode (like the white logos). */
  mono?: boolean;
  /** Opens the image in the gallery (I18); the title is its caption. */
  gallery?: boolean;
}
const { image, alt = '', title, border, ratio, mono = false, gallery = false } = Astro.props;
---

<div class="image-text measure-text reveal">
  <div class="art media-l" data-mono={mono || undefined} data-border={border === true ? 'both' : border || undefined} style={ratio && `--art-ratio: ${ratio}`}><Img src={image} alt={alt} sizes="(min-width: 768px) 480px, 60vw" gallery={gallery} caption={title} /></div>
  <div class="copy">
    <h3 class="t-body">{title}</h3>
    <div class="prose"><slot /></div>
  </div>
</div>

<style>
  .image-text { display: grid; grid-template-columns: 1fr; align-items: center; row-gap: var(--space-4); }
  .art { max-width: 60%; overflow: hidden; } /* corners: .media-l (16 px, 12 px on phones) */
  .art :global(img) { width: 100%; }
  .art[style*="--art-ratio"] :global(img) { aspect-ratio: var(--art-ratio); object-fit: cover; }
  .art[data-mono] { background: var(--bg-secondary); }
  .art[data-mono] :global(img) { filter: var(--filter-logo); }
  .art[data-border='both'] { border: 1px solid var(--border); }
  .art[data-border='dark-mode'] { border: 1px solid var(--border-dark-mode); }
  .art[data-border='light-mode'] { border: 1px solid var(--border-light-mode); }
  /* extra space between stacked rows, on top of the media slot's gap (20 px): 40 px in total */
  .image-text + .image-text { margin-top: var(--space-4); }
  .copy { display: flex; flex-direction: column; gap: var(--space-2); }
  /* body text in the strong colour (not bold); the first line's cap height starts level with the top of the image */
  .copy h3 { color: var(--text-strong); text-box: trim-start cap alphabetic; }
  @media (min-width: 768px) {
    .image-text { grid-template-columns: repeat(var(--measure-text-cols), minmax(0, 1fr));  column-gap: var(--gutter); }
    .art { grid-column: 1 / 4; max-width: none; }
    .copy { grid-column: 4 / -1; }
  }

</style>
