---
/** I5 Insight row: illustration (cols 1–4) + title and text (cols 5–9) on the 10-column media grid, so the text ends on the text measure. Stacked below 768 px. Repeat 3×. */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  title: string;
}
const { image, alt = '', title } = Astro.props;
---

<div class="insight measure-media reveal">
  <div class="art"><Img src={image} alt={alt} sizes="(min-width: 768px) 480px, 60vw" /></div>
  <div class="copy">
    <h3 class="t-subheading">{title}</h3>
    <div class="prose"><slot /></div>
  </div>
</div>

<style>
  .insight { display: grid; grid-template-columns: 1fr; align-items: center; row-gap: var(--space-4); }
  .art { max-width: 60%; }
  .art :global(img) { width: 100%; }
  .copy { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (min-width: 768px) {
    .insight { grid-template-columns: repeat(10, minmax(0, 1fr)); column-gap: var(--gutter); }
    .art { grid-column: 1 / 5; max-width: none; }
    .copy { grid-column: 5 / 10; }
  }
</style>
