---
/** I5 Insight row: illustration + title + text. 4 + 5 columns from 768 px, stacked below. Repeat 3×. */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  title: string;
}
const { image, alt = '', title } = Astro.props;
---

<div class="insight grid-12 measure-media reveal">
  <div class="span-5 art"><Img src={image} alt={alt} sizes="(min-width: 768px) 480px, 60vw" /></div>
  <div class="span-7 copy">
    <h3 class="t-heading-m">{title}</h3>
    <div class="prose"><slot /></div>
  </div>
</div>

<style>
  .insight { align-items: center; row-gap: var(--space-4); }
  .art { max-width: 60%; }
  .art :global(img) { width: 100%; }
  .copy { display: flex; flex-direction: column; gap: var(--space-3); max-width: 38rem; }
  @media (min-width: 768px) { .art { max-width: none; } }
</style>
