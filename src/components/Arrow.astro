---
/**
 * I8 Salmon hand-drawn arrow pointing down (annotation between before/after, or towards an embed).
 * Decorative: aria-hidden. Defaults to src/assets/arrow-red-down.svg; pass `src` for another arrow (e.g. arrow-red-right.svg).
 */
import arrowDown from '../assets/arrow-red-down.svg';

interface Props {
  src?: string;
  class?: string;
}
const { src = arrowDown.src, class: cls } = Astro.props;
---

<img src={src} alt="" aria-hidden="true" class={cls} />
