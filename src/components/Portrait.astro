---
/** Portrait: square photo at half the text measure (4 of 8 columns on desktop wide), radius 16. */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;
---

<div class="container portrait">
  <figure class="measure-text reveal">
    <Img src={src} alt={alt} class="media-l" sizes="(min-width: 1230px) 385px, 60vw" />
  </figure>
</div>

<style>
  .portrait { padding-bottom: var(--space-4); }
  figure :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  @media (min-width: 768px) { figure :global(img) { width: 50%; } }
</style>
