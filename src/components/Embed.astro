---
/**
 * I7 Interactive embed: iframe to a self-contained demo in public/demos/<slug>/.
 * Rule: text is always visible. Below 992 px the iframe is replaced by `poster` + `note`
 * (pass `poster` for demos that don't work at 375 px; omit it for demos that are responsive).
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Arrow from './Arrow.astro';

interface Props {
  src: string; // already base-prefixed, e.g. url('/demos/tokens/index.html')
  title: string; // required: accessible name of the iframe
  height?: number; // px at desktop; omit for a height that follows the width (53.4 % of the width + 170 px)
  poster?: ImageMetadata | string;
  posterAlt?: string;
  note?: string;
  caption?: string;
  /** Red hand-drawn arrow overlapping the top-right corner of the iframe, pointing at the demo's controls (desktop only). */
  arrow?: ImageMetadata | string;
  /** Arrow placement (CSS lengths): distance from the embed's right edge, from its top edge (negative = above), and its width. Defaults: 5%, -110px, 80px. */
  arrowRight?: string;
  arrowTop?: string;
  arrowWidth?: string;
  /** 12 columns instead of 10 on laptops (992–1229 px). */
  fullOnLaptop?: boolean;
  /** Gradient name from src/lib/gradients.ts ("dusk", "calm-blue" …): the demo sits on that gradient with padding around it. */
  stage?: string;
}
const { src, title, height, poster, posterAlt = '', note = 'Interactive demo, best viewed on desktop.', caption, arrow, stage, arrowRight, arrowTop, arrowWidth, fullOnLaptop = false } = Astro.props;
const arrowSrc = arrow ? (typeof arrow === 'string' ? arrow : arrow.src) : undefined;
---

<figure class:list={['embed measure-media reveal', { 'has-poster': !!poster, 'full-laptop': fullOnLaptop }]}
  style={[height && `--embed-h:${height}px`, arrowRight && `--arrow-right:${arrowRight}`, arrowTop && `--arrow-top:${arrowTop}`, arrowWidth && `--arrow-w:${arrowWidth}`].filter(Boolean).join(';') || undefined}>
  <div class:list={['stage', 'live', stage && `gradient gradient--${stage}`]}>
    <div class="frame">
      <iframe class:list={[stage ? 'media-m' : 'media-l media-hairline']} src={src} title={title} loading="lazy"></iframe>
      {arrowSrc && <Arrow src={arrowSrc} class="annot" />}
    </div>
  </div>
  {poster && (
    <div class="poster">
      <div class:list={['stage', stage && `gradient gradient--${stage}`]}>
        <Img src={poster} alt={posterAlt} class={stage ? undefined : 'media-l media-hairline'} />
      </div>
      <p class="t-caption caption">{note}</p>
    </div>
  )}
  {caption && <figcaption class="t-caption caption">{caption}</figcaption>}
</figure>

<style>
  .embed { display: flex; flex-direction: column; gap: var(--space-3); }
  .embed { container-type: inline-size; }
  /* On a stage the iframe is as high as the demo window it holds (aspect 1100 : 760, plus the demo's own 28 px inset), so only the
     stage padding and that inset remain around the window. */
  .stage.gradient { --stage-pad: var(--space-2); padding: var(--stage-pad); border-radius: var(--radius-m); }
  .stage.gradient iframe { height: var(--embed-h, calc((100cqw - 2 * var(--stage-pad) - 56px) * 0.6909 + 56px)); }
  /* The demo page is transparent and has no colour scheme of its own (light). If the iframe element were dark (the site default) some browsers (Safari)
     paint an opaque white backdrop behind it, hiding the gradient. Same scheme on both sides keeps it transparent. */
  /* no shadow on the iframe itself: it is transparent, so its shadow would only darken a halo around the iframe box. The demo window has its own shadow. */
  .stage.gradient iframe { color-scheme: light; background: transparent; }
  .frame { position: relative; }
  .frame :global(.annot) { display: none; }
  iframe { display: block; width: 100%; height: var(--embed-h, calc(53.4cqw + 170px)); background: var(--bg-raised); }
  .poster { display: none; flex-direction: column; gap: var(--space-3); }
  .poster :global(img) { width: 100%; }
  .poster .stage.gradient :global(img) { filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.4)); } /* the window in the poster has no shadow of its own */
  @media (min-width: 768px) { .stage.gradient { --stage-pad: var(--space-4); border-radius: var(--radius-l); } }
  @media (min-width: 992px) {
    .frame :global(.annot) { display: block; position: absolute; z-index: 2; pointer-events: none; right: var(--arrow-right, 5%); top: var(--arrow-top, -110px); width: var(--arrow-w, 80px); }
  }
  @media (min-width: 992px) and (max-width: 1229px) {
    .full-laptop { --n: 12; }
  }
  @media (max-width: 991px) {
    .has-poster .live { display: none; }
    .has-poster .poster { display: flex; }
  }
</style>
