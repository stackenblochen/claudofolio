---
/**
 * I7 Interactive embed: iframe to a self-contained demo in public/demos/<slug>/.
 * Rule: text is always visible. Below 992 px (tablet and mobile) the iframe is always replaced by a placeholder: the `poster` image with `note`
 * as its caption. On desktop and laptop the live demo shows, with the optional `caption` below it.
 * A button below the live demo opens it in fullscreen (Fullscreen API on the demo box; Esc or the same button exits). Hidden where the browser has no fullscreen.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Arrow from './Arrow.astro';
import maximize from '@tabler/icons/outline/arrows-maximize.svg?raw';
import minimize from '@tabler/icons/outline/arrows-minimize.svg?raw';

const icon = (svg: string, cls: string) => svg.replace('<svg', `<svg class="${cls}" aria-hidden="true" focusable="false"`);

interface Props {
  src: string; // already base-prefixed, e.g. url('/demos/tokens/index.html')
  title: string; // required: accessible name of the iframe
  height?: number; // px at desktop; omit for a height that follows the width (53.4 % of the width + 170 px)
  /** Placeholder image for tablet and mobile (required). */
  poster: ImageMetadata | string;
  posterAlt?: string;
  /** Caption under the placeholder on tablet and mobile. Default: "Interactive demo, best viewed on desktop." */
  note?: string;
  /** Optional caption under the live demo on desktop and laptop. Hidden on tablet and mobile, where `note` is shown instead. */
  caption?: string;
  /** Red hand-drawn arrow overlapping the top-right corner of the iframe, pointing at the demo's controls (desktop only). */
  arrow?: ImageMetadata | string;
  /** Arrow placement (CSS lengths): distance from the embed's right edge, from its top edge (negative = above), and its width. Defaults: 5%, -110px, 80px. */
  arrowRight?: string;
  arrowTop?: string;
  arrowWidth?: string;
  /** 12 columns instead of 10 on laptops (992–1229 px). */
  fullOnLaptop?: boolean;
  /** Gradient name from src/lib/gradients.ts ("dusk", "calm-blue" …): the demo sits on that gradient with padding around it. */
  stage?: string;
}
const { src, title, height, poster, posterAlt = '', note = 'Interactive demo, best viewed on desktop.', caption, arrow, stage, arrowRight, arrowTop, arrowWidth, fullOnLaptop = false } = Astro.props;
const arrowSrc = arrow ? (typeof arrow === 'string' ? arrow : arrow.src) : undefined;
---

<figure class:list={['embed measure-media reveal', { 'full-laptop': fullOnLaptop }]}
  style={[height && `--embed-h:${height}px`, arrowRight && `--arrow-right:${arrowRight}`, arrowTop && `--arrow-top:${arrowTop}`, arrowWidth && `--arrow-w:${arrowWidth}`].filter(Boolean).join(';') || undefined}>
  <div class:list={['stage', 'live', stage && `gradient gradient--${stage}`]} data-embed-live>
    <div class="frame">
      <iframe class:list={[stage ? 'media-m' : 'media-l media-border']} src={src} title={title} loading="lazy"></iframe>
      {arrowSrc && <Arrow src={arrowSrc} class="annot" />}
    </div>
    <button type="button" class="fs t-label" data-embed-fs aria-label="Enter fullscreen" hidden>
      <Fragment set:html={icon(maximize, 'on-enter')} /><Fragment set:html={icon(minimize, 'on-exit')} /><span>Fullscreen</span>
    </button>
  </div>
  <div class="poster">
    <div class:list={['stage', stage && `gradient gradient--${stage}`]}>
      <Img src={poster} alt={posterAlt} class={stage ? undefined : 'media-l media-border'} />
    </div>
    <p class="t-caption caption">{note}</p>
  </div>
  {caption && <figcaption class="t-caption caption live-caption">{caption}</figcaption>}
</figure>

<style>
  .embed { display: flex; flex-direction: column; gap: var(--space-3); }
  .embed { container-type: inline-size; }
  /* On a stage the iframe is as high as the demo window it holds (aspect 1100 : 760, plus the demo's own 28 px inset), so only the
     stage padding and that inset remain around the window. */
  .stage.gradient { --stage-pad: var(--space-2); padding: var(--stage-pad); border-radius: var(--radius-m); }
  .stage.gradient iframe { height: var(--embed-h, calc((100cqw - 2 * var(--stage-pad) - 56px) * 0.6909 + 56px)); }
  /* The demo page is transparent and has no colour scheme of its own (light). If the iframe element were dark (the site default) some browsers (Safari)
     paint an opaque white backdrop behind it, hiding the gradient. Same scheme on both sides keeps it transparent. */
  /* no shadow on the iframe itself: it is transparent, so its shadow would only darken a halo around the iframe box. The demo window has its own shadow. */
  .stage.gradient iframe { color-scheme: light; background: transparent; }
  .frame { position: relative; }
  /* fullscreen button: right under the demo (outside it); in fullscreen it floats over the bottom-right corner */
  .live { position: relative; margin-bottom: var(--space-6); }
  .fs { position: absolute; top: calc(100% + var(--space-2)); right: 0; display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--text-default); cursor: pointer; transition: background 150ms ease, color 150ms ease; }
  .fs:hover { background: var(--fill); color: var(--text-strong); }
  .fs:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
  .fs :global(svg) { width: 18px; height: 18px; }
  .fs :global(.on-exit), .fs[data-on] :global(.on-enter) { display: none; }
  .fs[data-on] :global(.on-exit) { display: block; }
  .live:fullscreen { display: flex; margin: 0; }
  .live.stage:fullscreen { padding: 0; border-radius: 0; }
  .live:fullscreen .frame { width: 100%; height: 100%; }
  .live:fullscreen .frame iframe { height: 100%; border-radius: 0; border: 0; box-shadow: none; }
  .live:fullscreen .fs { top: auto; bottom: var(--space-4); right: var(--space-4); background: var(--bg-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); color: var(--text-strong); }
  .frame :global(.annot) { display: none; }
  iframe { display: block; width: 100%; height: var(--embed-h, calc(53.4cqw + 170px)); background: var(--bg-secondary); }
  .poster { display: none; flex-direction: column; gap: var(--space-3); }
  .poster :global(img) { width: 100%; }
  .poster .stage.gradient :global(img) { filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.4)); } /* the window in the poster has no shadow of its own */
  @media (min-width: 768px) { .stage.gradient { --stage-pad: var(--space-4); border-radius: var(--radius-l); } }
  @media (min-width: 992px) {
    .frame :global(.annot) { display: block; position: absolute; z-index: 2; pointer-events: none; right: var(--arrow-right, 5%); top: var(--arrow-top, -110px); width: var(--arrow-w, 80px); }
  }
  @media (min-width: 992px) and (max-width: 1229px) {
    .full-laptop { --n: 12; }
  }
  @media (max-width: 991px) {
    .live { display: none; }
    .poster { display: flex; }
    .live-caption { display: none; } /* the caption describes the live demo: the poster has its own note */
  }
</style>
