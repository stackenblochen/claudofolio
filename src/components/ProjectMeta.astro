---
/** M1 Project meta row: label over value, spread evenly across the text measure (8 columns on desktop). Only rendered with at least 3 items. */
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<section class="meta">
  <div class="container">
    <dl class="meta-grid measure-text" style={`--count:${items.length}`}>
      {items.map((i) => (
        <div class="cell">
          <dt class="t-label">{i.label}</dt>
          <dd class="t-body">{i.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .meta { padding-top: var(--space-7); }
  .meta-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin: 0 auto; }
  @media (min-width: 768px) { .meta-grid { grid-template-columns: repeat(var(--count), minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--space-4); } }
  .cell { display: flex; flex-direction: column; gap: var(--space-2); }
  dt { color: var(--text-default); }
  dd { color: var(--text-strong); }
</style>
