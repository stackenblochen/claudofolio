---
/**
 * I17 Image grid: images of the same ratio in a grid on the media measure, 3 columns from 768 px, 2 below (every image is shown, none is cut).
 * Images use the screenshot look (radius 12, border, shadow, like Figure). No captions; the alt text carries the content.
 *
 *   <ImageGrid items={[{ src: a, alt: '…' }, { src: b, alt: '…' }]} />
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  items: { src: ImageMetadata | string; alt: string }[];
  /** Columns from 768 px. Default 3. */
  columns?: 2 | 3 | 4;
}
const { items, columns = 3 } = Astro.props;
---

<div class="measure-media group">
  <ul class="grid reveal" style={`--cols:${columns}`} role="list">
    {items.map((i) => (
      <li><Img src={i.src} alt={i.alt} class="media-m media-border media-shadow" sizes="(min-width: 768px) 400px, 50vw" /></li>
    ))}
  </ul>
</div>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .grid :global(img) { display: block; width: 100%; height: auto; }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--space-5); }
  }
</style>
