---
/**
 * Internal image helper. Local imports go through astro:assets (AVIF/WebP + srcset),
 * plain URL strings render a lazy <img>. Always pass meaningful `alt`, or alt="" for decoration.
 * With `gallery` the image becomes a button that opens it in the case-study gallery (`Gallery.astro`, I18); `caption` shows below it there.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Opens the image in the gallery (full size, zoom, browse). */
  gallery?: boolean;
  caption?: string;
}
const { src, alt, class: cls, sizes = '(min-width: 1230px) 1200px, 100vw', loading = 'lazy', fetchpriority, gallery = false, caption } = Astro.props;
const widths = [480, 768, 1200, 1600, 2400];
const isSvg = typeof src !== 'string' && src.format === 'svg';
// The gallery shows the image in full resolution (up to 3200 px wide), not the resized copy of the page.
const full = !gallery ? undefined : typeof src === 'string' ? src : isSvg ? src.src : (await getImage({ src, width: Math.min(src.width, 3200), format: 'webp', quality: 85 })).src;
const Wrap = gallery ? 'button' : Fragment;
const wrapProps = gallery
  ? { type: 'button', class: 'gallery-trigger', 'data-gallery': full, 'data-w': typeof src === 'string' ? undefined : src.width, 'data-h': typeof src === 'string' ? undefined : src.height, 'data-caption': caption || undefined, 'data-alt': alt || undefined, 'aria-label': `Open image in gallery${alt ? `: ${alt}` : ''}` }
  : {};
---

<Wrap {...wrapProps}>
  {typeof src === 'string'
    ? <img src={src} alt={alt} class={cls} loading={loading} decoding="async" />
    : isSvg
      ? <Image src={src} alt={alt} class={cls} format="svg" loading={loading} />
      : <Image src={src} alt={alt} class={cls} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} format="webp" />}
</Wrap>

<style>
  .gallery-trigger { display: block; width: 100%; padding: 0; margin: 0; border: 0; background: none; font: inherit; color: inherit; cursor: zoom-in; border-radius: var(--radius-l); }
  .gallery-trigger:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 4px; }
</style>
