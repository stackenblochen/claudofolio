---
/** I6 Video. MP4 (H.264) + optional WebM, with poster. Muted + playsinline; no autoplay unless it is a short loop. */
import type { ImageMetadata } from 'astro';
import pause from '@tabler/icons/outline/player-pause.svg?raw';
import play from '@tabler/icons/outline/player-play.svg?raw';

const icon = (svg: string, cls: string) => svg.replace('<svg', `<svg class="${cls}" aria-hidden="true" focusable="false"`);

interface Props {
  src: string;
  webm?: string;
  poster?: ImageMetadata | string;
  title: string; // accessible name
  caption?: string;
  loop?: boolean; // loop: plays while in view, no native controls, a Pause/Play button below the video
}
const { src, webm, poster, title, caption, loop = false } = Astro.props;
const posterUrl = poster ? (typeof poster === 'string' ? poster : poster.src) : undefined;
---

<figure class="video measure-media reveal">
  <video
    class="media-l media-border"
    poster={posterUrl}
    muted
    playsinline
    preload={loop ? 'auto' : 'metadata'}
    controls={!loop}
    loop={loop}
    aria-label={title}
    data-video-loop={loop ? '' : undefined}
  >
    {webm && <source src={webm} type="video/webm" />}
    <source src={src} type="video/mp4" />
  </video>
  {(caption || loop) && (
    <div class="media-bar">
      {caption && <figcaption class="t-caption">{caption}</figcaption>}
      {loop && (
        <button type="button" class="icon-btn" data-video-pp aria-label="Pause video" hidden>
          <Fragment set:html={icon(pause, 'icon-btn__a')} /><Fragment set:html={icon(play, 'icon-btn__b')} />
        </button>
      )}
    </div>
  )}
</figure>

<style>
  .video { display: flex; flex-direction: column; gap: var(--space-3); }
  video { width: 100%; background: var(--bg-secondary); }
</style>

