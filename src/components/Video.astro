---
/** I6 Video. MP4 (H.264) + optional WebM, with poster. Muted + playsinline; no autoplay unless it is a short loop. */
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  webm?: string;
  poster?: ImageMetadata | string;
  title: string; // accessible name
  caption?: string;
  loop?: boolean; // decorative loop: autoplay, no controls, aria-hidden
}
const { src, webm, poster, title, caption, loop = false } = Astro.props;
const posterUrl = poster ? (typeof poster === 'string' ? poster : poster.src) : undefined;
---

<figure class="video measure-media reveal">
  <video
    class="media-l media-hairline"
    poster={posterUrl}
    muted
    playsinline
    preload="metadata"
    controls={!loop}
    autoplay={loop}
    loop={loop}
    aria-label={loop ? undefined : title}
    aria-hidden={loop ? 'true' : undefined}
  >
    {webm && <source src={webm} type="video/webm" />}
    <source src={src} type="video/mp4" />
  </video>
  {caption && <figcaption class="t-body">{caption}</figcaption>}
</figure>

<style>
  .video { display: flex; flex-direction: column; gap: var(--space-3); }
  video { width: 100%; background: var(--bg-raised); }
</style>
