---
/**
 * The first part of the About content on the home page: the "About me" title, the intro paragraphs and the portrait below them (the site's original
 * Portrait.astro: square, 50% width from 768 px), between Selected work and Experience/Career/Education (AboutSections.astro).
 */
import SectionTitle from './SectionTitle.astro';
import Portrait from './Portrait.astro';
import portrait from '../assets/portrait.webp';
---

<div class="about">
  <SectionTitle id="about-title" chapter>About me</SectionTitle>

  <div class="container intro-wrap">
    <div class="measure-text stack" style="--stack-gap: var(--space-5)">
      <div class="intro stack t-subheading reveal">
        <p>I own the full process from research to shipped detail, and I'm at my best when I can do both: design hands-on and set the vision for where the product goes next.</p>
        <p>With a diploma in communications design and years of experience as a freelancer for agencies and in tech products, I bring a strong eye for visual detail to every project I work on.</p>
      </div>
    </div>
  </div>

  <Portrait src={portrait} alt="Portrait of Wolfgang, looking to the side, in front of a blue background, wearing a mustard-yellow sweater" />
</div>

<style>
  .intro-wrap { padding-top: var(--space-6); padding-bottom: var(--space-4); }
  .intro { --stack-gap: var(--space-4); color: var(--text-strong); font-family: var(--font-sans); word-spacing: normal; font-weight: 400; }
  .intro :global(p) { font: inherit; text-wrap: pretty; }
</style>
