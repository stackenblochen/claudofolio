---
/**
 * I11 Screen gallery: heading, intro and an optional uppercase note, then screens as cards on the media measure, each with title and category underneath.
 * Items are 2 per row from 768 px (1 on phones); `wide: true` lets an item take the full row. Images: radius 12, hairline, shadow (like Figure).
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  title?: string;
  intro?: string;
  note?: string;
  items: { src: ImageMetadata | string; alt: string; title: string; category?: string; wide?: boolean }[];
}
const { title = 'Selected screens', intro, note, items } = Astro.props;
---

<section class="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="measure-media">
      <div class="head reveal">
        <h2 class="t-heading" id="gallery-title">{title}</h2>
        {intro && <p class="t-body intro">{intro}</p>}
        {note && <p class="t-body t-upper note">{note}</p>}
      </div>
      <ul class="items">
        {items.map((i) => (
          <li class={`item reveal${i.wide ? ' wide' : ''}`}>
            <figure>
              <Img src={i.src} alt={i.alt} class="media-m media-hairline media-shadow" />
              <figcaption>
                <span class="t-body name">{i.title}</span>
                {i.category && <span class="t-body cat">{i.category}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .gallery { padding-block: var(--section-y); }
  .head { display: flex; flex-direction: column; gap: var(--space-3); }
  .intro { color: var(--text-default); }
  .note { color: var(--text-default); margin-top: var(--space-5); }
  .items { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; grid-template-columns: 1fr; gap: var(--space-6) var(--gutter); }
  .item :global(img) { width: 100%; }
  figure { display: flex; flex-direction: column; gap: var(--space-3); margin: 0; }
  figcaption { display: flex; flex-direction: column; }
  .name { color: var(--text-strong); }
  .cat { color: var(--text-default); }
  @media (min-width: 768px) {
    .items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .item.wide { grid-column: 1 / -1; }
  }
</style>
