---
/**
 * L1 Project teaser, bento variant (used by ProjectGrid variant="bento"): a card with the cover in an inner panel on top and,
 * below it, the title on the left and the company logo on the right. The whole card is the link. Hover: slight lift and border (fine pointer, no reduced motion).
 * The classic row teaser is ProjectCard.astro.
 */
import type { CardData } from '../lib/projects';
import Img from './Img.astro';
import Mock from './Mock.astro';

interface Props {
  card: CardData;
}
const { card } = Astro.props;
// each tinted card shows a different, zoomed-in area of the stage background image (see .panel[style*='--tint']::before)
const BG_POS: Record<string, string> = { blue: '88% 25%', violet: '0% 45%', green: '85% 100%', salmon: '45% 60%' };
---

<article class="bento">
  <a href={card.href} class="link-block">
    <div class:list={['panel', !card.thumb && card.coverFill && 'panel--fill']} style={card.tint && !(!card.thumb && card.coverFill) ? `--tint:var(--tint-${card.tint});--bg-pos:${BG_POS[card.tint] ?? 'center'}` : undefined}>
      <div class:list={['thumb', !card.thumb && (card.coverFill ? 'thumb--fill' : 'thumb--shape'), card.coverOutline === 'light' && 'thumb--outline-light', card.coverOutline === 'none' && 'thumb--outline-none']}>
        {card.thumb
          ? <Mock size="cover" stage={card.thumb.stage} theme={card.thumb.theme} layout={card.thumb.layout} phone={card.thumb.phone}
              devices={card.thumb.devices.map((d) => ({ ...d, bar: d.bar ? undefined : false }))} />
          : <Img src={card.cover} alt={card.coverAlt} sizes="(min-width: 768px) 560px, 100vw" />}
      </div>
    </div>
    <div class="foot">
      <h3 class="t-subheading">{card.title}</h3>
      {card.logo && <div class="logo" style={`--logo-h:${card.logo.height}px`}><Img src={card.logo.src} alt="" /></div>}
    </div>
  </a>
</article>

<style>
  .bento { position: relative; height: 100%; background: var(--bg-secondary); border-radius: var(--radius-l); overflow: hidden; }
  .bento::after { content: ''; position: absolute; inset: 0; z-index: 3; border: 1px solid transparent; border-radius: inherit; pointer-events: none; transition: border-color 250ms ease; }
  .bento:has(:focus-visible)::after { border-color: var(--border); }
  .link-block { display: flex; flex-direction: column; gap: var(--space-3); height: 100%; padding: var(--space-2); text-decoration: none; color: inherit; }

  /* inner panel: a step lighter than the card, rounded, the cover centred inside */
  .panel { flex: none; aspect-ratio: 4 / 3; overflow: hidden; display: grid; grid-template-rows: minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); place-items: center; min-height: 0; background: var(--bg-tertiary); border-radius: var(--radius-m, 12px); padding: var(--space-4); }
  .thumb { position: relative; width: 100%; --thumb-outline: var(--border-dark-mode); }
  .thumb--outline-light { --thumb-outline: var(--border-light-mode); }
  .thumb--outline-none { --thumb-outline: transparent; }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  .thumb--shape :global(img) {
    filter: drop-shadow(1px 0 0 var(--thumb-outline)) drop-shadow(-1px 0 0 var(--thumb-outline)) drop-shadow(0 1px 0 var(--thumb-outline)) drop-shadow(0 -1px 0 var(--thumb-outline))
      drop-shadow(0 0 20px light-dark(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.5)));
  }
  .thumb--shape.thumb--outline-none :global(img) { filter: none; }
  /* cards with a `teaserTint`: instead of a solid tint colour, the stage background image (as in HomeHero.astro, same opacity) over the panel colour */
  .panel[style*='--tint'] { position: relative; background: var(--bg-primary); } /* pure black / white (the standard context base), so the image mixes with it */
  .panel[style*='--tint']::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: url('../assets/stage/pramod2.jpg') var(--bg-pos, center) / 300% auto no-repeat; filter: saturate(0.6); opacity: 0.25; }
  /* full-bleed cover (`coverFill`): fills the whole panel edge to edge */
  .panel--fill { padding: 0; position: relative; }
  .panel--fill .thumb { position: absolute; inset: 0; width: 100%; height: 100%; }
  .panel--fill .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* cut-out cover and mocks: whole inside the panel, centred */
  .panel:not(.panel--fill) .thumb { max-height: 100%; }
  .panel:not(.panel--fill) .thumb--shape { height: 100%; }
  .panel:not(.panel--fill) .thumb--shape :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) var(--space-3) var(--space-3); }
  .foot h3 { margin: 0; font-family: var(--font-headline); word-spacing: var(--ws-headline); font-weight: var(--text-subheading-weight); letter-spacing: 0; font-size: 1.125rem; line-height: var(--lh-headline); }
  .logo { flex: none; line-height: 0; }
  .logo :global(img) { display: block; height: var(--logo-h); width: auto; max-width: 40vw; filter: var(--filter-logo); }
  @media (min-width: 992px) { .foot h3 { font-size: 1.25rem; } .foot { padding: var(--space-3) var(--space-3) var(--space-4); } }

  @media (min-width: 992px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .bento { transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 450ms ease; }
    .bento:hover { transform: scale(1.015); box-shadow: var(--shadow-elevated); }
    .bento:hover::after { border-color: light-dark(var(--color-white), var(--border)); }
  }
</style>
