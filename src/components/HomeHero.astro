---
/**
 * H1 Home intro: the headline and subline on the left, the doodles (DoodleStack) right next to them and never over them, on the page background.
 * Text and doodles form one group, centred in the stage (10 columns, media measure). Below 992 px the doodles sit under the text.
 *
 * Prism effect on the headline (see lib/prism.ts): while the pointer is over the stage, slices of the text shear sideways and split
 * into red / green / blue fringes around the cursor (stronger while it moves, a base level while it rests). The real DOM text stays in
 * place; a transparent WebGL canvas on top only paints where there is distortion. Needs a fine hovering pointer and no reduced-motion
 * preference, otherwise the headline is simply static.
 *
 * Slots: "intro" (the headline), "subline" (optional line below it, not part of the prism effect).
 */
import DoodleStack from './DoodleStack.astro';
---

<section class="home-hero" data-hero>
  <div class="container">
    <div class="stage measure-media" data-stage>
      <div class="group">
        <div class="text">
          <h1 class="intro t-title" data-intro><slot name="intro" /></h1>
          {Astro.slots.has('subline') && <p class="subline t-heading"><slot name="subline" /></p>}
        </div>
        <DoodleStack />
      </div>
      <canvas class="fx" data-fx aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding-top: calc(var(--header-h) + var(--space-3));
    background: var(--bg-page);
  }
  /* headline left, doodles right from 992 px; below that the doodles sit under the text */
  .stage {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-5);
    /* below 768 px the stage grows with its content (text + stack) and starts at the top, so the headline never slides under the header */
    justify-content: flex-start; padding-top: var(--space-4);
  }
  .group { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; width: 100%; }
  .text { position: relative; z-index: 3; display: flex; flex-direction: column; gap: var(--space-6); }
  .intro :global(em) { color: var(--accent-primary); }
  .subline { font-weight: 400; text-wrap: pretty; }
  .intro { font-size: 2rem; line-height: 1.19; /* fixed steps, no fluid scaling */ }
  @media (min-width: 768px) {
    .intro { font-size: 2.5rem; }
  }
  @media (min-width: 992px) {
    .stage {
      flex-direction: row; align-items: center; justify-content: center; padding-top: 0;
      height: clamp(26rem, 40vw + 15rem, 650px); /* about 650 px on desktop, so the stage no longer fills the whole screen */
    }
    /* text and doodles form one group, centred in the stage (and so on the screen), a small gap apart; the doodles are as high as the text block, no higher or lower */
    .group { flex-direction: row; align-items: stretch; gap: var(--space-5); width: auto; }
    .text { flex: 0 1 auto; }
    .intro { font-size: 3rem; }
  }
  @media (min-width: 1230px) {
    .intro { font-size: 3.5rem; }
  }
  /* effect canvas: same box as the stage, transparent, only visible while there is distortion; above the stack */
  .fx { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; opacity: 0; pointer-events: none; transition: opacity 260ms ease; }
  .fx:global(.is-on) { opacity: 1; }

  /* line breaks as designed on larger screens; the text reflows freely below 768 px */
  .intro :global(.br-md), .subline :global(.br-md) { display: none; }
  @media (min-width: 768px) { .intro :global(.br-md), .subline :global(.br-md) { display: inline; } }
</style>

<script>
  import { paintText, setupPrism, type Prism } from '../lib/prism';

  let stop: (() => void) | undefined;

  function init() {
    stop?.();
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-fx]');
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!stage || !canvas || !intro) return;
    // Only with a fine, hovering pointer and without reduced motion; otherwise the headline stays static.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const prism: Prism | null = setupPrism({
      stage,
      canvas,
      bg: document.querySelector<HTMLElement>('[data-hero]')!,
      paint: (ctx, rect) => paintText(ctx, rect, intro),
      repaintEachFrame: false,
      idleRepaintMs: 0,
    });
    if (!prism) return;

    const onMove = (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;
      const s = stage.getBoundingClientRect();
      prism.pointer(e.clientX, e.clientY, e.clientX - s.left, e.clientY - s.top);
    };
    stage.addEventListener('pointermove', onMove);
    stage.addEventListener('pointerleave', prism.leave);

    stop = () => {
      stage.removeEventListener('pointermove', onMove);
      stage.removeEventListener('pointerleave', prism.leave);
      prism.dispose();
      stop = undefined;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
