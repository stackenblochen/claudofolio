---
/**
 * H1 Home intro: the headline and subline on the left, the doodles (DoodleStack) right next to them and never over them, on the page background.
 * Text and doodles form one group, centred in the stage (10 columns, media measure). Below 992 px the doodles sit under the text.
 *
 * Slots: "intro" (the headline), "subline" (optional line below it), "actions" (optional row of `.btn` buttons under the text).
 */
import DoodleStack from './DoodleStack.astro';
---

<section class="home-hero">
  <div class="container">
    <div class="stage measure-media">
      <div class="group">
        <div class="text">
          <h1 class="intro t-title"><slot name="intro" /></h1>
          {Astro.slots.has('subline') && <p class="subline t-subheading"><slot name="subline" /></p>}
          {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
        </div>
        <DoodleStack />
      </div>
    </div>
  </div>
  <a class="scroll-hint" href="#selected-work" aria-label="Scroll to selected work">
    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="M18 13l-6 6" /><path d="M6 13l6 6" /></svg>
  </a>
</section>

<style>
  /* the stage fills 90% of the window height (so the next section peeks in below the arrow) (below the header), its content centred */
  .home-hero {
    box-sizing: border-box; position: relative; min-height: 90vh; min-height: 90svh; display: flex; flex-direction: column;
    padding-top: var(--header-h); padding-bottom: calc(var(--space-5) + 56px); /* clear of the arrow */
    background: var(--bg-primary);
  }
  /* down arrow at the bottom of the stage: points to the work below (a link to it), bobs gently */
  .scroll-hint {
    position: absolute; left: 50%; bottom: var(--space-5); transform: translateX(-50%); display: grid; place-items: center;
    width: 56px; height: 56px; border-radius: 50%; color: var(--text-default); opacity: 0.85; transition: opacity 200ms ease;
  }
  .scroll-hint:hover, .scroll-hint:focus-visible { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .scroll-hint svg { animation: hint-bob 2.2s ease-in-out infinite; } }
  @keyframes hint-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  .home-hero > .container { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  /* headline left, doodles right from 992 px; below that the doodles sit under the text */
  .stage {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-5);
    /* below 768 px the stage grows with its content (text + stack), centred in the window; padding keeps it clear of the header on short screens */
    justify-content: center; padding-block: var(--space-4);
  }
  .group { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; width: 100%; }
  .text { position: relative; z-index: 3; display: flex; flex-direction: column; gap: var(--space-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .intro { text-wrap: pretty; } /* fill the text width instead of balancing short lines */
  /* below 1230 px: fixed font-size steps (line height 1.19), no fluid scaling; from 1230 px the .t-title size applies */
  @media (max-width: 1229px) { .intro { font-size: 2rem; line-height: 1.19; } }
  @media (min-width: 768px) and (max-width: 1229px) { .intro { font-size: 2.5rem; } }
  @media (min-width: 992px) and (max-width: 1229px) { .intro { font-size: 3rem; } }
  .intro :global(em) { color: var(--accent-primary); }
  .subline { font-family: var(--font-sans); word-spacing: normal; font-weight: 400; text-wrap: pretty; }
  @media (min-width: 992px) {
    .stage {
      flex-direction: row; align-items: center; justify-content: center; padding-block: var(--space-6);
    }
    /* text and doodles form one group, centred in the stage (and so on the screen), a small gap apart; the doodles are as high as the text block, no higher or lower */
    .group { flex-direction: row; align-items: stretch; gap: var(--space-5); width: auto; }
    .text { flex: 0 1 auto; }
  }
  /* line breaks as designed on larger screens; the text reflows freely below 768 px */
  .intro :global(.br-md), .subline :global(.br-md) { display: none; }
  @media (min-width: 768px) { .intro :global(.br-md), .subline :global(.br-md) { display: inline; } }
</style>
