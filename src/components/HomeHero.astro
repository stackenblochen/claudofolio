---
/**
 * H1 Home intro: the headline across the 8 text columns with the buttons below, in front of a large crop of the glass prism cube (src/assets/crystal-cube-stage.webp),
 * placed like the Figma reference: its left corner about 40% in, bleeding off the top, right and bottom of the stage. Every page load tilts, scales and shifts the cube a
 * little differently, and it floats gently in place (CSS, about 1.5% and 1.4 degrees; still with reduced motion). The stage is only as high as its content.
 * The earlier prism shader background is kept in HomeHeroShader.astro; the doodles in DoodleStack.astro (neither is used).
 *
 * Slots: "intro" (the headline), "subline" (optional line below it), "actions" (optional row of `.btn` buttons under the text).
 */
import { Image } from 'astro:assets';
import cube from '../assets/crystal-cube-stage.webp';
---

<section class="home-hero">
  <div class="edge-blur" aria-hidden="true"></div>
  <div class="cube" data-cube aria-hidden="true"><Image src={cube} alt="" widths={[900, 1400, 2200]} sizes="(min-width: 1230px) 1100px, 900px" loading="eager" decoding="async" /></div>
  <div class="container">
    <div class="stage measure-text">
      <div class="text">
        <h1 class="intro t-title"><slot name="intro" /></h1>
        {Astro.slots.has('subline') && <p class="subline t-subheading"><slot name="subline" /></p>}
        {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
      </div>
    </div>
  </div>
</section>

<style>
  /* the stage is only as high as its content (no full-window height): the headline across the full 10 columns, the buttons below it */
  .home-hero {
    box-sizing: border-box; position: relative; display: flex; flex-direction: column;
    padding-top: calc(var(--header-h) + var(--space-7)); padding-bottom: var(--space-8);
    background: var(--bg-primary);
  }
  .stage { position: relative; }
  /* the cube: 187% of the stage height (so it keeps the Figma proportions at any width), its top 43% above the stage, its right side pushed 18% of the stage height out
     (translate is a share of the cube's own width). Tilt, scale and shift are random per page load (set by the script below). */
  .home-hero { overflow: hidden; background: var(--bg-primary); }
  .cube {
    position: absolute; z-index: 0; top: -43%; right: 0; height: 187%; aspect-ratio: 1; pointer-events: none;
    translate: calc(28% + var(--dx, 0%)) var(--dy, 0%); rotate: var(--rot, 0deg); scale: var(--scale, 1);
    opacity: 0; transition: opacity 900ms ease;
  }
  .cube.is-ready { opacity: var(--cube-opacity, 0.5); } /* dimmed, so it sits behind the text */
  @media (max-width: 767px) { .cube { --cube-opacity: 0.32; } } /* on phones the cube sits right behind the headline: dimmer still */
  .cube :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; }
  @media (prefers-reduced-motion: no-preference) {
    .cube :global(img) { animation: cube-float var(--float, 16s) ease-in-out var(--float-delay, 0s) infinite alternate; }
  }
  @keyframes cube-float {
    from { transform: translate3d(-1.6%, 1.4%, 0) rotate(-1.4deg); }
    to { transform: translate3d(1.6%, -1.4%, 0) rotate(1.4deg); }
  }
  /* blurred outer edges: a layer over the cube that blurs what is behind it, strongest at the four edges of the stage and fading out towards the middle
     (blur strength: the first value of blur(); how far it reaches: the percentages) */
  .edge-blur {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    -webkit-backdrop-filter: blur(22px); backdrop-filter: blur(22px);
    --m: linear-gradient(to right, #000, transparent 14%, transparent 86%, #000), linear-gradient(to bottom, #000, transparent 22%, transparent 78%, #000);
    -webkit-mask-image: var(--m); mask-image: var(--m);
  }
  .home-hero > .container { position: relative; z-index: 2; }
  .text { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .intro { text-wrap: pretty; }
  /* below 1230 px: fixed font-size steps (line height 1.19), no fluid scaling; from 1230 px the .t-title size applies */
  @media (max-width: 1229px) { .intro { font-size: 2rem; line-height: 1.19; } }
  @media (min-width: 768px) and (max-width: 1229px) { .intro { font-size: 2.75rem; } }
  @media (min-width: 992px) and (max-width: 1229px) { .intro { font-size: 3.25rem; } }
  @media (min-width: 1230px) { .intro { font-size: 3.75rem; line-height: 1.15; } }
  .intro :global(em) { color: var(--accent-primary); }
  .subline { font-family: var(--font-sans); word-spacing: normal; font-weight: 400; text-wrap: pretty; }
  /* optional designed line breaks (only where a page asks for them) */
  .intro :global(.br-md), .subline :global(.br-md) { display: none; }
  @media (min-width: 768px) { .intro :global(.br-md), .subline :global(.br-md) { display: inline; } }
</style>

<script>
  /* Every load a slightly different cube: tilt, size, position and float speed are random within a small range. */
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  function initCube() {
    const el = document.querySelector<HTMLElement>('[data-cube]');
    if (!el) return;
    el.style.setProperty('--rot', `${rand(-6, 6).toFixed(1)}deg`);
    el.style.setProperty('--scale', rand(0.94, 1.1).toFixed(3));
    el.style.setProperty('--dx', `${rand(-3, 3).toFixed(1)}%`);
    el.style.setProperty('--dy', `${rand(-3, 3).toFixed(1)}%`);
    el.style.setProperty('--float', `${rand(9, 13).toFixed(1)}s`);
    el.style.setProperty('--float-delay', `${(-rand(0, 10)).toFixed(1)}s`);
    // fade in once the picture has loaded (not before, or it would pop in)
    const img = el.querySelector('img');
    const show = () => requestAnimationFrame(() => el.classList.add('is-ready'));
    if (!img || img.complete) show(); else { img.addEventListener('load', show, { once: true }); img.addEventListener('error', show, { once: true }); }
  }
  document.addEventListener('astro:page-load', initCube);
</script>
