---
/**
 * H1 Home intro, now a full chat that plays once, on load (the hero is already in view then) and fills up from the bottom: the sender's picture
 * (with a green "available" dot) stays at the bottom edge, every message first shows a "typing" bubble there and then lands in the same place, pushing
 * the earlier bubbles up. The 👋 is a reaction chip on the first message (absolutely positioned, so it never changes the spacing). The chat's full
 * height is reserved from the start, so nothing below it moves. Once the whole sequence has played, the action buttons (slot "actions") fade
 * in below the chat: they are the site's main navigation (Work, About me, Contact), moved down from the header, which brings its own menu back
 * when the page is scrolled up past this hero. With reduced motion, or without JS, everything (chat and buttons) is simply shown at once.
 *
 * This chat engine was first built for the About intro; that section (AboutIntro.astro, now after Selected work and Experience/Career/Education) still
 * carries the fuller "I own the full process…" / "With a diploma…" paragraphs, but as plain, unanimated text — the chat here only plays the short
 * opener (greeting, name + tagline in one bubble, years of experience), kept bigger and a bit bolder than plain body text (`.bubble--lead`), since it
 * stands in for the old headline. The nav buttons line up with the bubbles, not with the picture beside them.
 * The old pointer-driven prism effect on the headline (lib/prism.ts) is not used here any more now that there is no single headline to run it on; the
 * glass cube background, the prism shader background (HomeHeroShader.astro) and the doodles (DoodleStack.astro) are earlier, unused stage variants,
 * kept for reference.
 *
 */
import Img from './Img.astro';
import { NAV, url } from '../lib/site';
import portrait from '../assets/portrait.webp';

const navItems = NAV.map((n) => ({ ...n, href: url(n.href) }));
---

<section class="home-hero section--pure" data-hero>
  <div class="container">
    <div class="stage measure-text">
      <!-- the stage as a short chat that fills up from the bottom (the portrait stays at the bottom, new messages land there and push the others up): name and role (with a 👋 reaction on it), years of experience, the formula, then the invitation -->
      <div class="chat" data-chat>
        <span class="avatar">
          <Img src={portrait} alt="Portrait of Wolfgang, looking to the side, in front of a blue background, wearing a mustard-yellow sweater" sizes="56px" />
          <i class="avatar-status" aria-hidden="true"></i>
          <span class="sr-only">Available</span>
        </span>
        <div class="bubbles" data-bubbles>
          <div class="bubble bubble--lead" data-msg>
            <span class="reaction" role="img" aria-label="Waving hand">👋</span>
            <p class="t-body">Hi, I'm <em>Wolfgang</em>, a design lead from Berlin.</p>
          </div>
          <div class="bubble bubble--lead" data-msg>
            <p class="t-body">10+ years of experience in designing complex products.</p>
          </div>
          <div class="bubble bubble--lead" data-msg>
            <p class="t-body">Strategy + craft = Me</p>
          </div>
          <div class="bubble bubble--lead bubble--last" data-msg>
            <p class="t-body">Let's talk&nbsp;<span role="img" aria-label="smiling face">🙂</span></p>
          </div>
          <div class="typing" data-typing aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </div>

      <!-- the main navigation, as big pills under the chat; the header's own menu takes over once the page is scrolled past here (SiteHeader.astro) -->
      <nav class="actions" data-actions data-hero-nav aria-label="Sections">
        {navItems.map((i) => <a class="btn t-label" href={i.href}>{i.label}</a>)}
      </nav>
    </div>
  </div>
</section>

<style>
  .home-hero {
    box-sizing: border-box; position: relative; display: flex; flex-direction: column;
    /* the hero fills the first screen and the chat (with the nav buttons) sits at its bottom edge, 120 px above it */
    min-height: 100vh; min-height: 100svh; justify-content: flex-end;
    padding-top: calc(var(--header-h) + var(--space-9)); padding-bottom: 120px;
    background: var(--bg-primary);
  }
  /* the doodle wallpaper behind the chat, like a WhatsApp chat: the doodle tile (src/assets/stage/doodle-bg.svg, black shapes) is used as a mask over a
     faint gray, so it follows the theme and stays barely visible on the stage background. Tiled, behind the content. */
  .home-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: color-mix(in srgb, var(--text-default) 4.5%, transparent);
    -webkit-mask: url('../assets/stage/doodle-bg.svg') 0 0 / 560px auto repeat;
            mask: url('../assets/stage/doodle-bg.svg') 0 0 / 560px auto repeat;
  }
  /* TRY: the photo background (src/assets/stage/pramod2.jpg) instead of the doodles; delete this rule (and the ::before above stays) to go back. */
  .home-hero::before {
    background: url('../assets/stage/pramod2.jpg') center / cover no-repeat;
    -webkit-mask: linear-gradient(to bottom, #000 25%, transparent 100%); /* fades out into the page background at the bottom */
            mask: linear-gradient(to bottom, #000 25%, transparent 100%);
    filter: saturate(0.8); opacity: 0.5; /* 50% transparent: the stage colour shows through */
  }
  .home-hero > .container { position: relative; }
  .stage { position: relative; }

  /* the chat: the sender's picture (a circle), bubbles like an incoming message (the last with a small tail pointing at the picture).
     The bubbles are as wide as their content. The picture is positioned absolutely (script below moves it to track the bottom of whichever
     bubble is currently the current one, including while it is still "typing"); without JS, or once everything is shown, it simply rests at the bottom. */
  /* From 768 px, the bubbles and the buttons below sit flush with the stage's own left edge, which is the text measure — the same left edge as the
     "Selected work" heading and every other section heading on the page. The picture is pulled out to the left of that edge by its own width + a gap
     (`--chat-indent`, a negative offset), so it overlaps into the margin instead of pushing the bubbles inward; this is the one deliberate exception
     to the grid. Below 768 px there is no spare margin for the picture to overlap into (the page itself only has a 20 px gutter there), so it stays
     flush at the left instead and the bubbles/buttons are indented clear of it, as before. */
  .stage { --chat-indent: calc(44px + var(--space-3)); }
  @media (min-width: 768px) { .stage { --chat-indent: calc(56px + var(--space-4)); } }
  .chat { --bubble: var(--color-white); --bubble-text: var(--gray-950); position: relative; display: flex; flex-direction: column; justify-content: flex-end; } /* light bubbles with dark text in both themes, so they stand out from the wallpaper. The chat fills up from the bottom: its height is reserved by the script (min-height = the full conversation), the bubbles sit at the bottom edge next to the picture. */
  .chat :global(.avatar) { position: absolute; left: 0; top: auto; bottom: 0; display: block; width: 44px; height: 44px; }
  .chat :global(.avatar) :global(img) { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  /* the green "available" dot, cut out of the picture's bottom right corner with a ring the colour of the section behind it */
  .avatar-status { position: absolute; right: 0; bottom: 0; width: 12px; height: 12px; border-radius: 50%; background: #34c759; box-shadow: 0 0 0 3px var(--bg-primary); }
  .bubbles { position: relative; display: flex; flex-direction: column; gap: var(--space-1); align-items: flex-start; min-width: 0; max-width: 40rem; margin-left: var(--chat-indent); }
  @media (min-width: 992px) { .bubbles { max-width: 56rem; } } /* wider bubbles on desktop (the stage's own width still caps them) */
  @media (min-width: 768px) {
    .chat :global(.avatar) { left: calc(-1 * var(--chat-indent)); width: 56px; height: 56px; }
    .avatar-status { width: 14px; height: 14px; }
    .bubbles { margin-left: 0; }
  }
  /* macOS-style squircle corners (`corner-shape`, Chrome/Edge 139+; other browsers keep the plain rounded corners) */
  .bubble, .typing { corner-shape: squircle; }
  .bubble { position: relative; background: var(--bubble); color: var(--bubble-text); border-radius: 32px; padding: var(--space-4) var(--space-4); box-shadow: 0 1px 2px light-dark(rgb(0 0 0 / 0.12), rgb(0 0 0 / 0.45)); }
  .bubble--last { border-bottom-left-radius: 0; }
  .bubble--last::before, .typing.has-tail::before { content: ''; position: absolute; bottom: 0; left: -9px; width: 10px; height: 14px; background: var(--bubble); clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .typing.has-tail { border-bottom-left-radius: 0; } /* the indicator before the last message wears the same tail as that message */
  .bubble p { margin: 0; font-family: var(--font-sans); word-spacing: normal; text-wrap: pretty; }
  .bubble :global(em) { font-style: normal; font-weight: 700; color: var(--color-salmon-600); } /* "Wolfgang": salmon, bolder than the rest of the bubble */
  /* the 👋 reaction: a big emoji, no chip behind it, sitting on the top edge of the first message (absolutely positioned, so it never changes the spacing between bubbles) */
  .reaction { position: absolute; top: -34px; right: var(--space-3); font-size: 3.25rem; line-height: 1; filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.35)); }
  /* the name/tagline and the years-of-experience bubbles: the whole chat now, since the longer paragraphs moved down to the About section (plain text
     there, not a chat bubble). Bigger and a bit bolder than plain body text, still the body font, so they read as the headline this chat replaces. */
  .bubble--lead p { font-size: 1.375rem; line-height: 1.3; font-weight: 500; }
  @media (min-width: 768px) { .bubble--lead p { font-size: 1.75rem; } }

  /* the chat plays once (script below): the picture and the bubbles appear one after the other, each after a short "typing" bubble, then the actions fade in.
     Hidden states only apply with JS (the .js flag), and not with reduced motion, so the content is always there. The space stays reserved, nothing jumps.
     The picture's pop-in is a scale only (its position is the separate `top` transition below, driven by inline style from the script). */
  :global(.js) .chat .bubble:not(.is-shown) { display: none; } /* not yet in the conversation: takes no space, so the stack grows from the bottom */
  :global(.js) .chat .bubble { opacity: 0; transform: scale(0.82) translateY(10px); transform-origin: left bottom; transition: opacity 200ms ease-out, transform 420ms cubic-bezier(0.22, 1.18, 0.36, 1); }
  :global(.js) .chat .bubble.is-in { opacity: 1; transform: none; }
  :global(.js) .chat.is-measuring .bubble { display: block; } /* the script briefly shows everything to reserve the chat's final height */
  :global(.js) .chat .reaction { opacity: 0; transform: scale(0.3) rotate(-14deg); transition: opacity 160ms ease-out 380ms, transform 480ms cubic-bezier(0.3, 1.6, 0.5, 1) 380ms; }
  :global(.js) .chat .bubble.is-in .reaction { opacity: 1; transform: none; }
  :global(.js) .chat :global(.avatar) { opacity: 0; transform: scale(0.85); transition: opacity 220ms ease, transform 300ms cubic-bezier(0.2, 1.3, 0.4, 1); }
  :global(.js) .chat :global(.avatar.is-in) { opacity: 1; transform: scale(1); }
  .typing { display: none; gap: 7px; align-items: center; box-sizing: border-box; padding: 0 var(--space-5); height: calc(1.3 * 1.375rem + 2 * var(--space-4)); border-radius: 32px; background: var(--bubble); box-shadow: 0 1px 2px light-dark(rgb(0 0 0 / 0.12), rgb(0 0 0 / 0.45)); opacity: 0; transform: scale(0.7) translateY(6px); transform-origin: left bottom; pointer-events: none; transition: opacity 140ms ease-out, transform 260ms cubic-bezier(0.22, 1.2, 0.36, 1); } /* same radius, shadow and one-line height as a lead bubble */
  @media (min-width: 768px) { .typing { height: calc(1.3 * 1.75rem + 2 * var(--space-4)); } }
  .typing.is-shown { display: flex; }
  .typing.is-leaving { position: absolute; left: 0; bottom: 0; } /* leaves the flow and fades out over the slot where the message lands */
  .typing.is-on { opacity: 1; transform: none; }
  .chat.is-measuring .typing { display: none; }
  .typing i { width: 10px; height: 10px; border-radius: 50%; background: var(--bubble-text); opacity: 0.55; animation: typing-dot 1.1s ease-in-out infinite; }
  .typing i:nth-child(2) { animation-delay: 0.16s; }
  .typing i:nth-child(3) { animation-delay: 0.32s; }
  @keyframes typing-dot { 0%, 70%, 100% { transform: translateY(0); opacity: 0.35; } 35% { transform: translateY(-4px); opacity: 0.85; } }

  /* the buttons: reserved space from the start, only shown (and only then in the tab order / hit-testable) once the chat has finished playing */
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); margin-left: var(--chat-indent); }
  @media (min-width: 768px) { .actions { margin-left: 0; } }
  :global(.js) .actions { opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity 260ms ease, transform 320ms cubic-bezier(0.2, 1, 0.3, 1); }
  :global(.js) .actions.is-in { opacity: 1; visibility: visible; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .chat :global(.avatar), :global(.js) .chat .bubble, :global(.js) .chat .reaction, :global(.js) .actions { opacity: 1; visibility: visible; transform: none; transition: none; }
    .typing { display: none; }
  }
</style>

<script>
  /* The chat plays once, right on load (the hero sits at the top of the page, already in view), and fills up from the bottom like a real conversation:
     the sender's picture stays at the bottom edge, each message first shows a "typing" bubble there and then lands in the same place, pushing the earlier
     bubbles up (they slide, FLIP style). The chat's full height is reserved from the start (min-height, measured with everything briefly visible), so
     nothing below it moves. The 👋 reaction pops onto the first message once it has landed. Once every bubble has landed, the action buttons fade in below
     the chat. With reduced motion, or without JS, everything is shown at once. */
  let stopChat: (() => void) | undefined;

  function initChat() {
    stopChat?.();
    const chat = document.querySelector<HTMLElement>('[data-chat]');
    const bubbles = document.querySelector<HTMLElement>('[data-bubbles]');
    const typing = document.querySelector<HTMLElement>('[data-typing]');
    const actions = document.querySelector<HTMLElement>('[data-actions]');
    if (!chat || !bubbles || !typing) return;
    const msgs = [...chat.querySelectorAll<HTMLElement>('[data-msg]')];
    const avatar = chat.querySelector<HTMLElement>('.avatar');

    // Shrink-wrap: a bubble that wraps would otherwise stay as wide as its box, leaving empty space to the right of the shorter lines. Each lead text is
    // set to the width of its longest line. Then the chat's height is reserved: with everything visible, the stack's height becomes the chat's min-height.
    // (Everything is shown for the measurement only, in the same frame, so nothing flashes.)
    const fit = () => {
      chat.classList.add('is-measuring');
      chat.style.minHeight = '';
      chat.querySelectorAll<HTMLElement>('.bubble--lead p').forEach((p) => {
        p.style.width = '';
        const r = document.createRange();
        r.selectNodeContents(p);
        const rects = [...r.getClientRects()];
        if (!rects.length) return;
        const mids = rects.map((x) => (x.top + x.bottom) / 2);
        if (Math.max(...mids) - Math.min(...mids) < 12) return; // one line (the emoji and bold name sit a few px off the text): nothing to shrink-wrap
        p.style.width = `${Math.ceil(Math.max(...rects.map((x) => x.right)) - Math.min(...rects.map((x) => x.left))) + 2}px`;
      });
      chat.style.minHeight = `${bubbles.offsetHeight}px`;
      chat.classList.remove('is-measuring');
    };
    fit();
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    const showAll = () => { msgs.forEach((m) => m.classList.add('is-shown', 'is-in')); avatar?.classList.add('is-in'); actions?.classList.add('is-in'); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { showAll(); return; }

    const timers: number[] = [];
    const wait = (ms: number) => new Promise<void>((done) => timers.push(window.setTimeout(done, ms)));
    let played = false;
    const jitter = (ms: number, spread: number) => ms * (1 - spread + Math.random() * 2 * spread);

    // FLIP: runs `change`, then slides every bubble that was already in the conversation from where it was to where it is now.
    const flip = (change: () => void) => {
      const shown = [...bubbles.querySelectorAll<HTMLElement>('.bubble.is-shown')];
      const tops = shown.map((el) => el.getBoundingClientRect().top);
      change();
      shown.forEach((el, i) => {
        const d = tops[i] - el.getBoundingClientRect().top;
        if (Math.abs(d) < 1) return;
        el.animate([{ transform: `translateY(${d}px)` }, { transform: 'translateY(0)' }], { duration: 480, easing: 'cubic-bezier(0.22, 1.1, 0.36, 1)' });
      });
    };

    const play = async () => {
      if (played) return;
      played = true;

      avatar?.classList.add('is-in'); // the picture is already at the bottom, it just pops in
      await wait(350);

      for (let i = 0; i < msgs.length; i++) {
        const m = msgs[i];
        // the typing bubble appears at the bottom (pushing the earlier bubbles up); longer text types longer
        typing.classList.remove('is-leaving');
        typing.classList.toggle('has-tail', m.classList.contains('bubble--last'));
        flip(() => typing.classList.add('is-shown'));
        void typing.offsetWidth; // so the transition runs from the hidden state
        typing.classList.add('is-on');
        const chars = (m.textContent ?? '').trim().length;
        await wait(jitter(i === 0 ? 650 : Math.min(900, 400 + chars * 3), 0.2)); // not the same every time

        // swap: the message takes the typing bubble's place in the same moment the typing bubble leaves (out of the flow, fading over the message)
        flip(() => { typing.classList.add('is-leaving'); typing.classList.remove('is-on'); m.classList.add('is-shown'); });
        void m.offsetWidth;
        m.classList.add('is-in');
        timers.push(window.setTimeout(() => typing.classList.remove('is-shown', 'is-leaving'), 280));
        await wait(jitter(420, 0.3)); // a short beat before the next one starts typing
      }

      // the buttons, once the whole conversation has played
      await wait(150);
      actions?.classList.add('is-in');
    };

    // Starts once the chat is in view (it already is, on load, since the hero sits at the top of the page). The observer alone can miss a jump to the
    // anchor (e.g. navigating back to "/"), so the scroll position is checked too.
    const inView = () => { const r = chat.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; };
    const check = () => { if (!played && inView()) play(); };
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) check(); }, { threshold: [0, 0.4, 0.8] });
    io.observe(chat);
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('hashchange', check);
    const poll = window.setInterval(() => { if (played) window.clearInterval(poll); else check(); }, 400); // a slow tab, or layout settling after load, without another event
    check();
    stopChat = () => { io.disconnect(); window.removeEventListener('scroll', check); window.removeEventListener('resize', fit); window.removeEventListener('hashchange', check); window.clearInterval(poll); timers.forEach(clearTimeout); stopChat = undefined; };
  }

  document.addEventListener('astro:page-load', initChat);
  document.addEventListener('astro:before-swap', () => stopChat?.());
</script>
