---
/**
 * H1 Home cover: full viewport, display headline, 3D portrait with a cursor spotlight revealing a coloured copy.
 * Spotlight + tilt run only with a fine pointer and without reduced-motion; elsewhere the coloured portrait shows statically.
 * Slot = headline, e.g.  Hi, I'm <span class="t-serif">Wolfgang</span>, a Product Designer based in Berlin.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  portrait?: ImageMetadata; // dark version
  portraitColor?: ImageMetadata; // coloured version (revealed by spotlight)
  portraitAlt?: string;
  scrollTarget?: string;
}
const { portrait, portraitColor, portraitAlt = '', scrollTarget = '#work' } = Astro.props;
---

<section class="home-hero section--raised" data-hero>
  {portrait && (
    <div class="stage" data-stage aria-hidden={portraitAlt ? undefined : 'true'}>
      <Img src={portrait} alt={portraitAlt} class="layer base" loading="eager" fetchpriority="high" sizes="100vw" />
      {portraitColor && <Img src={portraitColor} alt="" class="layer color" loading="eager" sizes="100vw" />}
    </div>
  )}
  <div class="container copy">
    <h1 class="t-display measure-media"><slot /></h1>
  </div>
  <a class="scroll" href={scrollTarget} aria-label="Scroll to selected work">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9l7 7 7-7" /></svg>
  </a>
</section>

<style>
  .home-hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; background: var(--bg-raised); padding-top: var(--header-h); }
  .stage { position: absolute; inset: 0; will-change: transform; transform-origin: center; }
  .stage :global(.layer) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .stage :global(.color) {
    --mx: 50%; --my: 50%;
    -webkit-mask-image: radial-gradient(circle 350px at var(--mx) var(--my), #000 250px, transparent 350px);
    mask-image: radial-gradient(circle 350px at var(--mx) var(--my), #000 250px, transparent 350px);
    opacity: 0; transition: opacity 300ms;
  }
  .home-hero.is-spotlight .stage :global(.color) { opacity: 1; }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .stage :global(.color) { opacity: 1; -webkit-mask-image: none; mask-image: none; }
  }
  .copy { position: relative; z-index: 2; }
  h1 { text-shadow: 0 2px 30px light-dark(rgba(255, 255, 255, 0.6), rgba(0, 0, 0, 0.6)); }
  .scroll { position: absolute; bottom: var(--space-5); left: 50%; translate: -50% 0; color: var(--text-default); z-index: 2; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const stage = hero?.querySelector<HTMLElement>('[data-stage]');
    const color = stage?.querySelector<HTMLElement>('.color');
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hero && stage && fine && !calm) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        hero.classList.add('is-spotlight');
        stage.style.transform = `perspective(2000px) scale(1.1) rotateY(${(x - 0.5) * 6}deg) rotateX(${(0.5 - y) * 6}deg)`;
        color?.style.setProperty('--mx', `${x * 100}%`);
        color?.style.setProperty('--my', `${y * 100}%`);
      });
      hero.addEventListener('pointerleave', () => {
        hero.classList.remove('is-spotlight');
        stage.style.transform = '';
      });
    }
  });
</script>
