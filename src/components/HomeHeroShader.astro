---
/**
 * H1 Home intro: the headline across the 10 media columns with the buttons below, on a still prism background (a zoomed-in glass cube with bands of spectral light;
 * see the script at the bottom). The stage is only as high as its content. The doodles (DoodleStack.astro) are not
 * used in this iteration; the component is kept.
 *
 * Slots: "intro" (the headline), "subline" (optional line below it), "actions" (optional row of `.btn` buttons under the text).
 */
---

<section class="home-hero">
  <canvas class="prism-bg" data-prism-bg aria-hidden="true"></canvas>
  <div class="container">
    <div class="stage measure-media">
      <div class="text">
        <h1 class="intro t-title"><slot name="intro" /></h1>
        {Astro.slots.has('subline') && <p class="subline t-subheading"><slot name="subline" /></p>}
        {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
      </div>
    </div>
  </div>
</section>

<style>
  /* the stage is only as high as its content (no full-window height): the headline across the full 10 columns, the buttons below it */
  .home-hero {
    box-sizing: border-box; position: relative; display: flex; flex-direction: column;
    padding-top: calc(var(--header-h) + var(--space-7)); padding-bottom: var(--space-8);
    background: var(--bg-primary);
  }
  .stage { position: relative; }
  /* animated prism pattern behind everything (see the script below); the content sits above it */
  .prism-bg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block; }
  .home-hero > .container { position: relative; z-index: 1; }
  .text { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .intro { text-wrap: pretty; }
  /* below 1230 px: fixed font-size steps (line height 1.19), no fluid scaling; from 1230 px the .t-title size applies */
  @media (max-width: 1229px) { .intro { font-size: 2rem; line-height: 1.19; } }
  @media (min-width: 768px) and (max-width: 1229px) { .intro { font-size: 2.75rem; } }
  @media (min-width: 992px) and (max-width: 1229px) { .intro { font-size: 3.25rem; } }
  @media (min-width: 1230px) { .intro { font-size: 3.75rem; line-height: 1.15; } }
  .intro :global(em) { color: var(--accent-primary); }
  .subline { font-family: var(--font-sans); word-spacing: normal; font-weight: 400; text-wrap: pretty; }
  /* optional designed line breaks (only where a page asks for them) */
  .intro :global(.br-md), .subline :global(.br-md) { display: none; }
  @media (min-width: 768px) { .intro :global(.br-md), .subline :global(.br-md) { display: inline; } }
</style>

<script>
  /* Prism background: a still picture of light bent through faceted glass, drawn once by a WebGL shader. The stage shows sharp-edged facets
     (a zoomed-in glass cube: three faces meeting at a corner); inside each face hard-edged bands carry a rainbow from one side to the other, and the cube's edges catch a thin bright rim.
     Behind the text, kept quiet so the headline stays readable. Theme aware (colours are read from the page) and redrawn on resize.
     Without WebGL the section simply keeps its flat background. */
  const VERT = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;
  const FRAG = `
    precision highp float;
    uniform vec2 u_res; uniform float u_dpr, u_gain, u_light, u_seed;
    uniform vec3 u_bg;
    vec2 h2(vec2 p){ p += u_seed; return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453); }
    float h1(float n){ return fract(sin((n + u_seed) * 127.1) * 43758.5453); }
    // spectrum: a ramp from blue through cyan, green and yellow to orange and magenta (c in 0..1)
    vec3 spec(float c){ return clamp(0.5 + 0.55 * cos(6.2831 * (c * 0.85 + vec3(0.0, 0.33, 0.67)) + 0.6), 0.0, 1.0); }
    // distance from q to the ray that starts at the origin and points along r (large when q is behind it)
    float rayDist(vec2 q, vec2 r){ return dot(q, r) > 0.0 ? abs(q.x * r.y - q.y * r.x) : 9.0; }
    void main(){
      vec2 px = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y) / u_dpr; // css px, origin top left
      vec2 size = u_res / u_dpr;
      float S = 520.0;                                                   // zoom: a face is a few times the size of the stage
      vec2 c = vec2(size.x * 0.66, size.y * 0.7);                        // the front corner of the cube
      vec2 q = (px - c) / S;
      float th = atan(q.y, q.x);                                         // screen angle, y points down
      vec2 rUR = vec2(cos(-0.5236), sin(-0.5236));                       // the three edges that leave the front corner: up right, down, up left
      vec2 rD  = vec2(0.0, 1.0);
      vec2 rUL = vec2(cos(-2.618), sin(-2.618));
      // which face: right (between up right and down), left (between down and up left), top (between up left and up right)
      float face = (th > -0.5236 && th < 1.5708) ? 0.0 : (th < -2.618 || th > 1.5708) ? 1.0 : 2.0;
      // inside a face: hard-edged bands parallel to one of its edges, each band a spectrum from one side to the other
      vec2 dir = face < 0.5 ? rD : face < 1.5 ? rUL : rUR;
      vec2 nrm = vec2(-dir.y, dir.x);
      float hF = h1(face * 5.0 + 1.0);
      float u = dot(q, nrm) * (1.8 + 1.4 * hF) + hF * 7.0;
      float bid = floor(u), f = fract(u);
      float on = step(0.55, h1(bid * 3.7 + face * 17.0));
      float lo = 0.05 + 0.25 * h1(bid + face * 2.0), hi = lo + 0.3 + 0.35 * h1(bid * 1.9 + face);
      float aa = 0.012;
      float across = clamp((f - lo) / (hi - lo), 0.0, 1.0);
      float band = on * smoothstep(lo, lo + aa, f) * (1.0 - smoothstep(hi - aa, hi, f)) * (0.2 + 0.8 * pow(1.0 - across, 1.5)); // sharp edge on one side, the light fades out towards the other
      vec3 bandCol = spec((f - lo) / (hi - lo) + h1(bid + face * 4.0) * 0.4);
      float faceLight = face < 0.5 ? 0.9 : face < 1.5 ? 0.6 : 1.0;      // faces catch the light differently
      // a soft glow inside each face, strongest towards its edge with the next face
      float glow = pow(clamp(1.0 - rayDist(q, face < 0.5 ? rD : face < 1.5 ? rUL : rUR) * 1.4, 0.0, 1.0), 2.0);
      vec3 acc = bandCol * band * faceLight + spec(hF + 0.25) * glow * 0.2 * faceLight;
      // bright rims along the three edges, and fainter ones from the far corner seen through the glass
      float e1 = min(rayDist(q, rUR), min(rayDist(q, rD), rayDist(q, rUL)));
      vec2 q2 = q - vec2(-0.32, -0.28);
      float e2 = min(rayDist(q2, -rUR), min(rayDist(q2, -rD), rayDist(q2, -rUL)));
      float rim = (1.0 - smoothstep(0.0, 2.0 / S, e1)) * 0.7 + (1.0 - smoothstep(0.0, 1.5 / S, e2)) * 0.28;
      acc += vec3(0.9, 0.95, 1.0) * rim;
      float lum = max(max(acc.r, acc.g), acc.b);
      vec3 col;
      if (u_light > 0.5) col = mix(u_bg, acc / max(lum, 0.001), clamp(lum, 0.0, 1.0) * u_gain);
      else col = u_bg + acc * u_gain;
      gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
    }`;

  const rgb = (s: string): [number, number, number] | null => {
    const m = s.match(/rgba?\(\s*([\d.]+)[ ,]+([\d.]+)[ ,]+([\d.]+)/);
    if (m) return [+m[1] / 255, +m[2] / 255, +m[3] / 255];
    const c = s.match(/color\(srgb\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)/);
    return c ? [+c[1], +c[2], +c[3]] : null;
  };

  /** Which arrangement of facets is drawn (any number; changes the band pattern). */
  const SEED = 3.0;

  let stopPrism: (() => void) | undefined;

  function initPrismBg() {
    stopPrism?.();
    const canvas = document.querySelector<HTMLCanvasElement>('[data-prism-bg]');
    const host = canvas?.parentElement;
    if (!canvas || !host) return;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
    if (!gl) return;
    const sh = (type: number, src: string) => { const x = gl.createShader(type)!; gl.shaderSource(x, src); gl.compileShader(x); return x; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = U('u_res'), uSeed = U('u_seed'), uDpr = U('u_dpr'), uGain = U('u_gain'), uLight = U('u_light'), uBg = U('u_bg');

        let dpr = 1;

    const colours = () => {
      const cs = getComputedStyle(host);
      const bg = rgb(cs.backgroundColor) ?? [0.05, 0.05, 0.07];
      gl.uniform3f(uBg, bg[0], bg[1], bg[2]);
      // how strongly the light shows: quiet enough that the headline stays easy to read
      const light = document.documentElement.dataset.theme === 'light';
      gl.uniform1f(uLight, light ? 1 : 0);
      gl.uniform1f(uGain, light ? 0.4 : 0.5);
    };
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.round(host.clientWidth * dpr)), h = Math.max(1, Math.round(host.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uRes, w, h);
      gl.uniform1f(uDpr, dpr);
    };
    const draw = () => { gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };

    resize(); colours(); gl.uniform1f(uSeed, SEED); draw();
    const ro = new ResizeObserver(() => { resize(); draw(); });
    ro.observe(host);
    // the theme switch fades the page colours: read them again after the fade, too
    const mo = new MutationObserver(() => { colours(); draw(); [250, 700].forEach((ms) => window.setTimeout(() => { colours(); draw(); }, ms)); });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    stopPrism = () => { ro.disconnect(); mo.disconnect(); stopPrism = undefined; };
  }

  document.addEventListener('astro:page-load', initPrismBg);
  document.addEventListener('astro:before-swap', () => stopPrism?.());
</script>
