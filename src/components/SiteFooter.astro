---
/** G3 Footer: one line at the text measure (8 columns on wide desktops, 9 on tablets, full width on phones): copyright + imprint left, contact links right (wraps on mobile). Links look like the main navigation: no underline, a 2 px salmon underline on hover. */
import { SITE, url } from '../lib/site';

const year = new Date().getFullYear();
const links = [
  SITE.email && { label: 'Email', href: `mailto:${SITE.email}` },
  SITE.linkedin && { label: 'LinkedIn', href: SITE.linkedin },
  SITE.cvUrl && { label: 'CV', href: url(SITE.cvUrl) },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="site-footer">
  <div class="container">
    <div class="bar measure-text t-label">
    <p>© {year} {SITE.name}. All rights reserved. <a href={url('/imprint/')}>Imprint</a></p>
    {links.length > 0 && (
      <ul class="links" role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    )}
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-8); padding-block: var(--space-5) var(--space-8); background: var(--bg-page); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2) var(--space-5); }
  /* same as the main navigation: no underline by default, strong text and a 2 px salmon underline on hover (the border is always 2 px, so nothing shifts) */
  .site-footer a {
    color: var(--text-default); text-decoration: none; padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }
  .site-footer a:hover { color: var(--text-strong); border-bottom-color: var(--accent-primary); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-5); padding: 0; margin: 0; list-style: none; }
</style>
