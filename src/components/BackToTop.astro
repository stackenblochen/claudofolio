---
/** G4 Back-to-top button. Appears after one viewport of scrolling. The arrow is the bubbly one (BubbleArrow). */
import BubbleArrow from './BubbleArrow.astro';
---

<button class="to-top" type="button" aria-label="Back to top" hidden data-to-top>
  <BubbleArrow dir="up" size={22} />
</button>

<style>
  .to-top {
    position: fixed; right: var(--space-4); bottom: var(--space-4); z-index: 90;
    width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--border); background: var(--fill); color: var(--text-strong); cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  /* the same hover as the nav pills: solid salmon */
  .to-top:hover, .to-top:focus-visible { color: light-dark(var(--color-white), var(--gray-950)); background: var(--accent-primary); border-color: var(--accent-primary); }
  .to-top[hidden] { display: none; }
</style>

<script>
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    ac = new AbortController();
    const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
    if (!btn) return;
    const update = () => { btn.hidden = window.scrollY < window.innerHeight; };
    update();
    window.addEventListener('scroll', update, { passive: true, signal: ac.signal });
    btn.addEventListener('click', () => window.scrollTo({ top: 0 }), { signal: ac.signal });
  });
</script>
