---
/**
 * L1 Project teaser: full media-width panel (same measure as figures), text left, cover right.
 * Below 768 px the text sits on top of the cover. Dark overlay on hover.
 */
import type { CardData } from '../lib/projects';
import Img from './Img.astro';

interface Props {
  card: CardData;
}
const { card } = Astro.props;
---

<article class="teaser">
  <a href={card.href} class="link-block">
    <div class="copy">
      <h3 class="t-subheading">{card.title}</h3>
      <p class="cat t-label">{card.category}</p>
      {card.summary && <p class="sum t-body">{card.summary}</p>}
    </div>
    <div class="thumb media-l">
      <Img src={card.cover} alt={card.coverAlt} sizes="(min-width: 768px) 600px, 100vw" />
    </div>
  </a>
</article>

<style>
  .teaser { background: var(--bg-raised); border-radius: var(--radius-l); overflow: hidden; }
  .link-block { display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-5) var(--space-4) 0; text-decoration: none; color: inherit; }
  .copy { display: flex; flex-direction: column; gap: var(--space-2); }
  .cat { color: var(--text-default); }
  .sum { margin-top: var(--space-1); }
  .thumb { position: relative; }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  .thumb::after { content: ''; position: absolute; inset: 0; background: var(--overlay-thumb); opacity: 0; transition: opacity 200ms; }
  .link-block:hover .thumb::after, .link-block:focus-visible .thumb::after { opacity: 1; }
  @media (min-width: 768px) {
    .link-block { flex-direction: row; align-items: center; gap: var(--space-6); padding: var(--space-6); }
    .copy { flex: 0 0 34%; }
    .thumb { flex: 1 1 0; min-width: 0; }
  }
</style>
