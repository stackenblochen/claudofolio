---
/**
 * L1 Project teaser: full media-width panel (same measure as figures). From 1230 px two equal columns, fixed 340 px high: text left
 * (top aligned) with summary, cover right (centred). 992–1229 px: 5/7 columns, 340 px high, summary cut to three lines with an ellipsis. 768–991 px: no summary, 5/7 columns, height follows the cover.
 * Below 768 px the labels and title sit on top of the cover, 20 px padding all round, no summary.
 *
 * From 992 px, with a fine hovering pointer (and no reduced-motion preference), the card grows slightly (5 %), gets a border and a
 * lifted shadow while the pointer is on it. The border also shows on keyboard focus. The whole panel is the link. On touch, below 992 px and with
 * reduced motion the teaser stays plain. (The former colour-split ripple on hover is switched off; its code is kept in lib/teaser-fx.ts.)
 */
import type { CardData } from '../lib/projects';
import Img from './Img.astro';
import Mock from './Mock.astro';
import LabelList from './LabelList.astro';

interface Props {
  card: CardData;
}
const { card } = Astro.props;
const Tag = card.comingSoon ? 'div' : 'a';
---

{/* "coming soon": same panel, but a plain div with a tag instead of the link */}
<article class:list={['teaser', card.comingSoon && 'teaser--soon']} data-teaser={card.comingSoon ? undefined : ''}>
  <Tag href={card.comingSoon ? undefined : card.href} class="link-block">
    <div class="copy" data-teaser-copy>
      <LabelList labels={card.labels} />
      <h3 class="t-subheading">{card.title}</h3>
      {card.summary && <p class="sum t-label">{card.summary}</p>}
      {card.comingSoon && <span class="soon t-label">Coming soon</span>}
    </div>
    <div class="stage">
    <div class:list={['thumb', !card.thumb && (card.coverFill ? 'thumb--fill media-xs' : 'thumb--shape'), card.coverOutline === 'light' && 'thumb--outline-light']} data-teaser-thumb>
      {card.thumb
        ? <Mock size="cover" stage={card.thumb.stage} theme={card.thumb.theme} layout={card.thumb.layout} phone={card.thumb.phone}
            devices={card.thumb.devices.map((d) => ({ ...d, bar: d.bar ? undefined : false }))} />
        : <Img src={card.cover} alt={card.coverAlt} sizes="(min-width: 768px) 600px, 100vw" />}
    </div>
    </div>
  </Tag>
</article>

<style>
  /* ===== Sizes you can change here =====
     --teaser-h: height of the card (from 992 px)
     --teaser-copy-top / --teaser-copy-bottom: space above and below the text
     --teaser-thumb-pad: space around the thumb
     The gap between the cards is set in ProjectGrid.astro (the same on Home and under "Other projects"). */
  .teaser { --teaser-h: 320px; --teaser-copy-top: var(--space-5); --teaser-copy-bottom: var(--space-6); --teaser-thumb-pad: var(--space-6); }
  @media (min-width: 1230px) { .teaser { --teaser-h: 320px; --teaser-copy-top: var(--space-6); --teaser-copy-bottom: var(--space-7); } }

  .teaser { position: relative; background: var(--bg-secondary); border-radius: var(--radius-l); overflow: hidden; }
  /* border, only shown on hover (and keyboard focus). Drawn as an overlay, so it adds no size and shifts nothing (the text keeps
     lining up with the section headline). */
  .teaser::after { content: ''; position: absolute; inset: 0; z-index: 3; border: 1px solid var(--border); border-color: transparent; border-radius: inherit; pointer-events: none; transition: border-color 250ms ease; }
  .teaser:has(:focus-visible)::after { border-color: var(--border); }
  .link-block { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-4); text-decoration: none; color: inherit; }
  .copy { display: flex; flex-direction: column; gap: var(--space-2); } /* tight on mobile and tablet */
  .copy h3 { font-family: var(--font-sans); word-spacing: normal; font-weight: var(--weight-emphasis); letter-spacing: var(--ls-emphasis); } /* teaser titles stay Geist */
  .sum { color: var(--text-default); }
  .sum { display: none; } /* the summary only shows from 992 px, below that the teaser stays compact */
  .soon { display: inline-block; width: fit-content; padding: var(--space-1) var(--space-3); border: 1px solid var(--border); border-color: var(--border); border-radius: var(--radius-pill); color: var(--text-strong); }
  .teaser--soon .stage { opacity: 0.6; }
  .stage { display: grid; place-items: center; }
  .thumb { position: relative; width: 100%; --thumb-outline: var(--border-dark-mode); } /* the outline shows in dark mode; `coverOutline: light` in the frontmatter swaps it to light mode */
  .thumb--outline-light { --thumb-outline: var(--border-light-mode); }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  /* cut-out cover (transparent background, e.g. a window with a phone): the screenshot shadow and a 1 px outline in one mode only follow the shape of
     the image content, not the edges of the image (the same look as a Mock; a Mock thumb brings its own) */
  .thumb--shape :global(img) {
    filter: drop-shadow(1px 0 0 var(--thumb-outline)) drop-shadow(-1px 0 0 var(--thumb-outline)) drop-shadow(0 1px 0 var(--thumb-outline)) drop-shadow(0 -1px 0 var(--thumb-outline))
      drop-shadow(0 0 20px light-dark(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.5)));
  }
  /* full-bleed cover (`coverFill`): fills the image area with rounded corners and, in dark mode only, a 1 px outline */
  .thumb--fill { overflow: hidden; box-shadow: 0 0 0 1px var(--thumb-outline); }

  /* 768–991: text left, cover right and wider (7 of 12 parts). Height follows the cover, whose padding is the same on all sides. */
  @media (min-width: 768px) {
    .link-block { display: grid; grid-template-columns: 5fr 7fr; align-items: start; gap: 0; padding: 0; }
    /* the teaser is half a column wider on each side than the headline above it, so the text starts half a column in and lines up with it */
    .copy { padding: var(--space-5) var(--space-6) var(--space-6); padding-left: calc(var(--col-step) / 2); }
    .stage { align-self: stretch; padding: var(--space-5); }
  }

  @media (min-width: 992px) {
    .copy { gap: var(--space-4); container-type: inline-size; }
    /* the title shrinks (down to 18 px) with the text column, so it stays on one line wherever it fits; a longer title still wraps */
    .copy h3 { font-size: clamp(1.125rem, 7cqi, 1.5rem); }
  }

  /* 992–1229: with the summary; cover column one column wider than half (7 of 12), fixed 280 px (the narrow text column can wrap the title and the labels), summary clamped to three lines.
     The thumb is a 16:10 area that fills the height of its column and is centred horizontally; a cut-out cover sits whole inside it, a full-bleed cover fills it. */
  @media (min-width: 992px) {
    .link-block { grid-template-rows: var(--teaser-h); }
    .copy { padding: var(--teaser-copy-top) var(--space-5) var(--teaser-copy-bottom); padding-left: calc(var(--col-step) / 2); }
    .stage { display: flex; justify-content: center; align-items: center; padding: var(--teaser-thumb-pad); }
    .thumb { width: auto; height: 100%; max-width: 100%; aspect-ratio: 16 / 10; }
    .thumb--shape :global(img) { height: 100%; object-fit: contain; }
    .thumb--fill :global(img) { height: 100%; object-fit: cover; }
    .sum { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; } /* three lines, then an ellipsis */
  }
  /* from 1230 px: two equal columns (the height and paddings are the variables at the top) */
  @media (min-width: 1230px) {
    .link-block { grid-template-columns: 1fr 1fr; }
    .copy { padding: var(--teaser-copy-top) var(--space-7) var(--teaser-copy-bottom); padding-left: calc(var(--col-step) / 2); }
    .sum { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; } /* three lines at most, then an ellipsis */
  }

  /* hover effects: only from 992 px, with a fine hovering pointer and without reduced motion. The card grows slightly and gets a border
     (see ::after above) and a shadow while the pointer is on it. */
  @media (min-width: 992px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .teaser { transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 450ms ease; }
    .teaser:not(.teaser--soon):hover { transform: scale(1.05); box-shadow: var(--shadow-elevated); }
    .teaser:not(.teaser--soon):hover::after { border-color: light-dark(var(--color-white), var(--border)); } /* white on hover in light mode */
  }
</style>

