---
/**
 * L1 Project teaser: full media-width panel (same measure as figures), text left, cover right.
 * Below 768 px the text sits on top of the cover.
 *
 * With a fine hovering pointer (and no reduced-motion preference) the cover rests 15% smaller and pops up while the teaser is
 * active, and the colour-split prism effect (see lib/prism.ts) plays on the text around the pointer (not on the cover): slices
 * shear sideways and split into red / green / blue fringes, then settle when the pointer rests. The real DOM stays in place; a
 * transparent canvas on top only paints where there is distortion. The whole panel is the link. On touch and with reduced
 * motion the teaser stays plain.
 */
import type { CardData } from '../lib/projects';
import Img from './Img.astro';

interface Props {
  card: CardData;
}
const { card } = Astro.props;
---

<article class="teaser" data-teaser>
  <a href={card.href} class="link-block">
    <div class="copy" data-teaser-copy>
      <h3 class="t-subheading">{card.title}</h3>
      <p class="cat t-label">{card.category}</p>
      {card.summary && <p class="sum t-body">{card.summary}</p>}
    </div>
    <div class="thumb media-l" data-teaser-thumb>
      <Img src={card.cover} alt={card.coverAlt} sizes="(min-width: 768px) 600px, 100vw" />
    </div>
  </a>
  <canvas class="fx" data-teaser-fx aria-hidden="true"></canvas>
</article>

<style>
  .teaser { position: relative; background: var(--bg-raised); border-radius: var(--radius-l); overflow: hidden; }
  .link-block { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-5) var(--space-4) 0; text-decoration: none; color: inherit; }
  .copy { display: flex; flex-direction: column; gap: var(--space-2); }
  .cat { color: var(--text-default); }
  .sum { margin-top: var(--space-1); }
  .thumb { position: relative; }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  @media (min-width: 768px) {
    .link-block { flex-direction: row; align-items: center; gap: var(--space-6); padding: var(--space-6); }
    .copy { flex: 0 0 34%; }
    .thumb { flex: 1 1 0; min-width: 0; }
  }

  /* hover effects: only with a fine hovering pointer and without reduced motion */
  .fx { display: none; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* transparent canvas over the card, only visible while there is distortion */
    .fx { display: block; position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; border-radius: var(--radius-l); pointer-events: none; opacity: 0; transition: opacity 200ms ease; }
    .fx:global(.is-on) { opacity: 1; }
    /* the cover rests a bit smaller and pops up with a springy overshoot while the teaser is active (like the headline on the stage) */
    .thumb { transform: scale(0.85); transform-origin: 50% 50%; transition: transform 620ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .teaser.is-active .thumb { transform: translateY(-6px) scale(1.03); }
  }
</style>

<script>
  import { paintText, setupPrism, type Prism } from '../lib/prism';

  let stops: (() => void)[] = [];

  function init() {
    stops.forEach((fn) => fn());
    stops = [];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll<HTMLElement>('[data-teaser]').forEach((teaser) => {
      const canvas = teaser.querySelector<HTMLCanvasElement>('[data-teaser-fx]');
      const copy = teaser.querySelector<HTMLElement>('[data-teaser-copy]');
      if (!canvas || !copy) return;

      // Only the text goes into the effect texture; the cover is left alone and keeps showing through the transparent canvas.
      const prism: Prism | null = setupPrism({
        stage: teaser,
        canvas,
        bg: teaser,
        paint: (ctx, rect) => paintText(ctx, rect, copy),
        radius: (w) => Math.min(Math.max(w * 0.22, 180), 280),
      });
      if (!prism) return;

      const onEnter = (e: PointerEvent) => { if (e.pointerType !== 'touch') teaser.classList.add('is-active'); };
      const onMove = (e: PointerEvent) => {
        if (e.pointerType === 'touch') return;
        const r = teaser.getBoundingClientRect();
        prism.pointer(e.clientX, e.clientY, e.clientX - r.left, e.clientY - r.top);
      };
      const onLeave = () => { teaser.classList.remove('is-active'); prism.leave(); };

      teaser.addEventListener('pointerenter', onEnter);
      teaser.addEventListener('pointermove', onMove);
      teaser.addEventListener('pointerleave', onLeave);
      stops.push(() => {
        teaser.removeEventListener('pointerenter', onEnter);
        teaser.removeEventListener('pointermove', onMove);
        teaser.removeEventListener('pointerleave', onLeave);
        teaser.classList.remove('is-active');
        prism.dispose();
      });
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { stops.forEach((fn) => fn()); stops = []; });
</script>
