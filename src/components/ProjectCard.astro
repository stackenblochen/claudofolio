---
/**
 * L1 Project teaser: full media-width panel (same measure as figures). From 1230 px two equal columns, fixed 380 px high: text left
 * (top aligned) with summary, cover right (centred). 992–1229 px: 5/7 columns, 340 px high, summary cut to three lines with an ellipsis. 768–991 px: no summary, 5/7 columns, height follows the cover.
 * Below 768 px the title and category sit on top of the cover, 20 px padding all round, no summary.
 *
 * From 992 px, with a fine hovering pointer (and no reduced-motion preference), the whole card grows by 1% while the pointer is on it, and a one-off colour-split ripple (see lib/prism.ts, lib/teaser-fx.ts) runs over the whole card, text and cover, from the
 * point where the pointer entered: slices shear sideways and split into red / green / blue fringes along a travelling wave front,
 * then everything is shown untouched again. The real DOM stays in place; a transparent canvas on top only paints where there is
 * distortion. The whole panel is the link. On touch, below 992 px and with reduced motion the teaser stays plain.
 */
import type { CardData } from '../lib/projects';
import Img from './Img.astro';
import Mock from './Mock.astro';

interface Props {
  card: CardData;
}
const { card } = Astro.props;
---

<article class="teaser" data-teaser>
  <a href={card.href} class="link-block">
    <div class="copy" data-teaser-copy>
      <h3 class="t-subheading">{card.title}</h3>
      <p class="cat t-body">{card.category}</p>
      {card.summary && <p class="sum t-label">{card.summary}</p>}
    </div>
    <div class="stage">
    <div class:list={['thumb', 'media-l', !card.thumb && 'thumb--img']} data-teaser-thumb>
      {card.thumb
        ? <Mock size="cover" stage={card.thumb.stage} theme={card.thumb.theme} layout={card.thumb.layout} phone={card.thumb.phone}
            devices={card.thumb.devices.map((d) => ({ ...d, bar: d.bar ? undefined : false }))} />
        : <Img src={card.cover} alt={card.coverAlt} sizes="(min-width: 768px) 600px, 100vw" />}
    </div>
    </div>
  </a>
  <canvas class="fx" data-teaser-fx aria-hidden="true"></canvas>
</article>

<style>
  .teaser { position: relative; background: var(--bg-raised); border-radius: var(--radius-l); overflow: hidden; }
  /* hairline border, only shown on hover (and keyboard focus). Drawn as an overlay, so it adds no size and shifts nothing (the text keeps
     lining up with the section headline). */
  .teaser::after { content: ''; position: absolute; inset: 0; z-index: 3; border: var(--border-hairline); border-color: transparent; border-radius: inherit; pointer-events: none; transition: border-color 250ms ease; }
  .teaser:global(.is-active)::after, .teaser:has(:focus-visible)::after { border-color: var(--border-subtle); }
  .link-block { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-4); text-decoration: none; color: inherit; }
  .copy { display: flex; flex-direction: column; gap: var(--space-2); } /* tight on mobile and tablet */
  .cat, .sum { color: var(--text-default); }
  .sum { display: none; } /* the summary only shows from 992 px, below that the teaser stays compact */
  .stage { display: grid; place-items: center; }
  .thumb { position: relative; width: 100%; }
  .thumb--img :global(img) { display: block; width: 100%; height: auto; }

  /* 768–991: text left, cover right and wider (7 of 12 parts). Height follows the cover, whose padding is the same on all sides. */
  @media (min-width: 768px) {
    .link-block { display: grid; grid-template-columns: 5fr 7fr; align-items: start; gap: 0; padding: 0; }
    /* the teaser is half a column wider on each side than the headline above it, so the text starts half a column in and lines up with it */
    .copy { padding: var(--space-6); padding-left: calc(var(--col-step) / 2); }
    .stage { align-self: stretch; padding: var(--space-5); }
  }

  @media (min-width: 992px) { .copy { gap: var(--space-4); } }

  /* 992–1229: with the summary; cover column one column wider than half (7 of 12), fixed 340 px, summary clamped to three lines */
  @media (min-width: 992px) {
    .link-block { grid-template-rows: 340px; }
    .copy { padding: var(--space-6) var(--space-5); padding-left: calc(var(--col-step) / 2); }
    .sum { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; } /* three lines, then an ellipsis */
  }
  /* from 1230 px: two equal columns, fixed 380 px high */
  @media (min-width: 1230px) {
    .link-block { grid-template-columns: 1fr 1fr; grid-template-rows: 380px; }
    .copy { padding: var(--space-7); padding-left: calc(var(--col-step) / 2); }
    .sum { display: block; overflow: visible; }
  }

  /* hover effects: only from 992 px, with a fine hovering pointer and without reduced motion */
  .fx { display: none; }
  @media (min-width: 992px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* transparent canvas over the card, only visible while the ripple runs */
    .fx { display: block; position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; border-radius: var(--radius-l); pointer-events: none; opacity: 0; transition: opacity 60ms ease; }
    .fx:global(.is-on) { opacity: 1; }
    /* the whole card grows very slightly while the pointer is on it */
    .teaser { transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1); }
    .teaser:global(.is-active) { transform: scale(1.05); }
  }
</style>

<script>
  import '../lib/teaser-fx';
</script>
