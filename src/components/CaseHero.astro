---
/**
 * H2 + H3 Case hero. variant "mockup": H1, then cover image with the stamp overlapping its bottom-right corner.
 * variant "backdrop": full-cover dimmed background image, H1 bottom-aligned, stamp below.
 * H1 is sentence case, ≤ 8 words.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Stamp from './Stamp.astro';

interface Props {
  title: string;
  variant?: 'mockup' | 'backdrop';
  image?: ImageMetadata | string;
  imageAlt?: string;
  background?: ImageMetadata | string;
  confidential?: boolean;
}
const { title, variant = 'mockup', image, imageAlt = '', background, confidential = false } = Astro.props;
const bg = background ? (typeof background === 'string' ? background : background.src) : undefined;
---

<section class:list={['hero', variant, { 'has-stamp': confidential }]}>
  {variant === 'backdrop' && bg && <div class="bg" style={`background-image:url(${bg})`} aria-hidden="true"></div>}
  <div class="container">
    <h1 class:list={['t-title', variant === 'backdrop' ? 'measure-media' : 'measure-wide']}>{title}</h1>

    {variant === 'mockup' && image && (
      <div class="mock-wrap">
        <div class="mock">
          <Img src={image} alt={imageAlt} class="media-m app-shot" loading="eager" fetchpriority="high" sizes="(min-width: 1230px) 900px, 100vw" />
        </div>
      </div>
    )}
    {confidential && <div class="stamp-row measure-text"><Stamp class="stamp" /></div>}
  </div>
</section>

<style>
  .hero { position: relative; padding-top: var(--hero-top); padding-bottom: var(--space-6); isolation: isolate; }
  .hero.backdrop { background: var(--bg-raised); padding-bottom: var(--space-7); }
  .bg { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; opacity: 0.5; }
  .hero.backdrop { min-height: 70vh; display: flex; align-items: flex-end; }
  .hero.backdrop .container { padding-top: var(--space-9); }
  h1 { padding-bottom: var(--space-4); text-align: center; }
  .mock-wrap { margin-top: var(--space-7); }
  .mock { position: relative; margin-inline: auto; width: calc(100% * 12 / 12); }
  @media (min-width: 768px) { .mock { width: calc(100% * 11 / 12 - var(--gutter) / 12); } }
  @media (min-width: 992px) { .mock { width: calc(100% * 10 / 12 - var(--gutter) * 2 / 12); } }
  @media (min-width: 1230px) { .mock { width: calc(100% * 9 / 12 - var(--gutter) * 3 / 12); } }
  .mock :global(img) { width: 100%; }
  /* The stamp sits right under the visual, inside the text measure, and reaches down into the lead's top padding
   * so the "Background" eyebrow lines up with its lower edge. */
  .hero.has-stamp, .hero.backdrop.has-stamp { padding-bottom: 0; }
  .stamp-row { position: relative; z-index: 5; margin-top: var(--space-2); margin-bottom: calc(var(--section-y) * -1); }
  .stamp-row :global(.stamp) { width: min(60%, 260px); margin-left: auto; }
  @media (min-width: 768px) { .stamp-row :global(.stamp) { width: 33%; margin-right: 8%; } }
  .hero:not(.has-stamp) .mock-wrap { padding-bottom: var(--space-5); }
</style>
