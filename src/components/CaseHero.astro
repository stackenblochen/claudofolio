---
/**
 * H2 + H3 Case hero. variant "mockup": H1, then the cover image with the stamp overlapping its bottom-right corner. The cover is a cutout
 * (window and phone on transparent) exported with its 1 px outline baked in; the soft shadow comes from .app-shot. No radius, no extra outline.
 * variant "backdrop": full-cover dimmed background image, H1 bottom-aligned, stamp below.
 * `glow` (mockup only; frontmatter `heroGlow`) puts the soft halo of the project teasers behind the image: a lighter gray with a trace of salmon.
 * `fill` (frontmatter `coverFill`): the cover is a full-bleed image (a photo scene), not a cutout: it is bigger (the full 12-column width), rounded like the other image areas (`--radius-l`) and gets the dark-mode outline instead of the cutout shadow.
 * H1 is sentence case, ≤ 8 words. The expertise labels sit on top of it as an eyebrow.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Stamp from './Stamp.astro';
import LabelList from './LabelList.astro';
import { highlight } from '../lib/site';

interface Props {
  title: string;
  variant?: 'mockup' | 'backdrop';
  image?: ImageMetadata | string;
  imageAlt?: string;
  background?: ImageMetadata | string;
  confidential?: boolean;
  labels?: string[];
  glow?: boolean;
  fill?: boolean;
}
const { title, variant = 'mockup', image, imageAlt = '', background, confidential = false, labels = [], glow = false, fill = false } = Astro.props;
const bg = background ? (typeof background === 'string' ? background : background.src) : undefined;
---

<section class:list={['hero', variant, { 'has-stamp': confidential, 'no-eyebrow': labels.length === 0 }]}>
  {variant === 'backdrop' && bg && <div class="bg" style={`background-image:url("${bg}")`} aria-hidden="true"></div>}
  <div class="container">
    {labels.length > 0 && <div class="eyebrow"><LabelList labels={labels} align="center" /></div>}
    <h1 class:list={['t-title', variant === 'backdrop' ? 'measure-media' : 'measure-wide']} set:html={highlight(title)} />

    {variant === 'mockup' && image && (
      <div class="cover-wrap">
        <div class:list={['cover', { glow, fill }]}>
          <Img src={image} alt={imageAlt} class={fill ? undefined : 'app-shot'} loading="eager" fetchpriority="high" sizes={fill ? '(min-width: 1230px) 1170px, 100vw' : '(min-width: 1230px) 900px, 100vw'} />
        </div>
      </div>
    )}
    {confidential && <div class="stamp-row measure-text"><Stamp class="stamp" /></div>}
  </div>
</section>

<style>
  .hero { position: relative; padding-top: var(--hero-top); padding-bottom: var(--space-6); isolation: isolate; }
  /* without the label eyebrow the headline keeps the room the labels took (a pill of about 27 px plus 12 px of space) */
  .hero.no-eyebrow { padding-top: calc(var(--hero-top) + 2.5rem); }
  /* The backdrop hero is a dark image band in both themes: it resolves the semantic tokens as dark, so the title stays light in light mode. */
  .hero.backdrop { color-scheme: dark; background: var(--bg-secondary); padding-top: 80px; padding-bottom: var(--space-7); }
  @media (min-width: 544px) { .hero.backdrop { padding-top: 100px; } }
  @media (min-width: 992px) { .hero.backdrop { padding-top: 140px; } }
  .hero.backdrop.no-eyebrow { padding-top: 120px; }
  @media (min-width: 544px) { .hero.backdrop.no-eyebrow { padding-top: 140px; } }
  @media (min-width: 992px) { .hero.backdrop.no-eyebrow { padding-top: 180px; } }
  /* Height as on the original page: the stamp follows the title directly and hangs 30–40 px below the band. */
  .hero.backdrop .container { display: flow-root; }
  .hero.backdrop h1 { padding-bottom: 0; }
  .hero.backdrop .stamp-row { margin-top: 30px; margin-bottom: -30px; }
  @media (min-width: 544px) { .hero.backdrop .stamp-row { margin-top: 40px; margin-bottom: -40px; } }
  @media (min-width: 992px) { .hero.backdrop .stamp-row { margin-top: 0; } }
  .bg { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; opacity: 0.5; }
  .eyebrow { margin-bottom: var(--space-3); }
  h1 { padding-bottom: var(--space-4); text-align: center; }
  .cover-wrap { margin-top: var(--space-7); }
  .cover { position: relative; margin-inline: auto; width: calc(100% * 12 / 12); }
  @media (min-width: 768px) { .cover { width: calc(100% * 11 / 12 - var(--gutter) / 12); } }
  @media (min-width: 992px) { .cover { width: calc(100% * 10 / 12 - var(--gutter) * 2 / 12); } }
  @media (min-width: 1230px) { .cover { width: calc(100% * 9 / 12 - var(--gutter) * 3 / 12); } }
  .cover :global(img) { width: 100%; }
  /* full-bleed photo cover: the whole 12 columns, rounded like the other image areas, thin outline in dark mode */
  .cover.fill { width: 100%; }
  .cover.fill :global(img) { display: block; border-radius: var(--radius-l); box-shadow: 0 0 0 1px var(--border-dark-mode); }
  /* optional halo behind the image (the same colours as the teaser halo, a little stronger because the stage is bigger) */
  .cover.glow { isolation: isolate; --glow-color: color-mix(in srgb, var(--accent-primary) 10%, var(--gray-600)); --glow: 55%; }
  :global(:root[data-theme='light']) .cover.glow { --glow-color: color-mix(in srgb, var(--accent-primary) 3%, var(--color-white)); --glow: 90%; }
  .cover.glow::before {
    content: ''; position: absolute; inset: -35% -30%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--glow-color) var(--glow), transparent), transparent);
  }
  /* The stamp sits right under the visual, inside the text measure, and reaches down into the lead's top padding
   * so the "Background" eyebrow lines up with its lower edge. */
  .hero.has-stamp, .hero.backdrop.has-stamp { padding-bottom: 0; }
  .stamp-row { position: relative; z-index: 5; margin-top: var(--space-6); margin-bottom: calc(var(--section-y) * -1 - var(--space-5)); }
  .stamp-row :global(.stamp) { width: min(40%, 260px); margin-left: auto; }
  @media (min-width: 768px) { .stamp-row :global(.stamp) { width: 28%; margin-right: 8%; } }
  .hero:not(.has-stamp) .cover-wrap { padding-bottom: var(--space-5); }
</style>
