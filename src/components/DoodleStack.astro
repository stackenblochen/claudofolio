---
/**
 * Home stage: a stack of doodles, screenshots and emoji behind the right half of the headline (the headline may overlap them). A new
 * picture lands on top at a random spot, tilt and size inside the box; the older ones sink back (smaller and fainter) and the oldest
 * fade out, so 3-5 are visible at once. With a mouse, pictures are triggered by moving over the hero: every ~200 px of travel
 * spawns one anywhere over the hero (at most one per 160 ms), so fast movement piles them up and a resting pointer adds nothing. On
 * touch devices from 768 px (tablets) scrolling does the same (every ~120 px while the hero is on screen); on phones a new one lands
 * every 1.4-2.6 s. Pictures come from src/assets/doodles/ (already optimised WebP, max 640 px); they are drawn from a shuffled bag, so none
 * repeats until all have been shown. Decorative only (aria-hidden). With reduced motion a static arrangement of four is shown.
 * Single-colour black/white pictures follow the theme (see BLACK / WHITE).
 */
/** Single-colour pictures that follow the theme: black ones are inverted to white in dark mode, white ones to black in light mode. */
const BLACK = new Set(['wl', 'wolfgang-black', 'blob-black', 'blob-black-2', 'cursor-black']);
const WHITE = new Set(['shape-white-a', 'shape-white-b']);
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/doodles/*.webp', { eager: true });
const items = Object.entries(files).map(([path, mod]) => {
  const name = path.split('/').pop()!.replace('.webp', '');
  const { src, width, height } = mod.default;
  return { src, ratio: +(width / height).toFixed(3), kind: name.startsWith('emoji') ? 'emoji' : 'pic', mono: BLACK.has(name) ? 'dark' : WHITE.has(name) ? 'light' : '' };
});
---

<div class="doodles" data-doodles data-items={JSON.stringify(items)} aria-hidden="true"></div>

<style>
  .doodles { --doodle-shadow: 0.2; position: relative; width: 100%; height: 15rem; flex: none; user-select: none; pointer-events: none; }
  /* from 768 px: behind the right half of the stage, the headline sits above it */
  @media (min-width: 768px) { .doodles { position: absolute; z-index: 1; right: 0; top: 0; width: 46%; height: 100%; } }
  :global(:root[data-theme='light']) .doodles { --doodle-shadow: 0.08; }
  .doodles :global(.doodle) {
    position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1%); max-height: 60%; object-fit: contain; height: auto;
    translate: -50% -50%;
    rotate: calc(var(--r) * 1deg);
    scale: calc(var(--s, 1) * (1 - var(--depth, 0) * 0.045));
    opacity: 0; z-index: var(--z, 1);
    transition: opacity 380ms ease, scale 520ms cubic-bezier(0.34, 1.4, 0.64, 1), rotate 520ms cubic-bezier(0.34, 1.4, 0.64, 1), translate 520ms cubic-bezier(0.34, 1.4, 0.64, 1);
    filter: drop-shadow(0 0.3rem 0.7rem rgb(0 0 0 / var(--doodle-shadow)));
    /* very subtle, endless float; amplitude, direction and speed are random per picture (set by JS) */
    animation: doodle-float var(--fd, 7s) ease-in-out var(--fl, 0s) infinite;
  }
  @keyframes doodle-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(var(--fx, 3px), var(--fy, -4px)) rotate(var(--fr, 1deg)); }
  }
  /* new picture: starts smaller, tilted the other way and slightly low, then springs into place */
  .doodles :global(.doodle.is-new) { scale: calc(var(--s, 1) * 0.7); rotate: calc(var(--r) * -0.6deg); translate: -50% -42%; transition: none; }
  .doodles :global(.doodle[data-depth='0']) { opacity: 1; }
  .doodles :global(.doodle[data-depth='1']) { opacity: 0.72; }
  .doodles :global(.doodle[data-depth='2']) { opacity: 0.48; }
  .doodles :global(.doodle[data-depth='3']) { opacity: 0.3; }
  .doodles :global(.doodle[data-depth='4']) { opacity: 0.18; }
  .doodles :global(.doodle.is-gone) { opacity: 0; }
  /* idle: fades out in place */
  .doodles :global(.doodle.is-dissolving) { opacity: 0; transition: opacity 1100ms ease-in; }
  :global(:root:not([data-theme='light'])) .doodles :global(.doodle[data-mono='dark']),
  :global(:root[data-theme='light']) .doodles :global(.doodle[data-mono='light']) { filter: invert(1) drop-shadow(0 0.3rem 0.7rem rgb(0 0 0 / var(--doodle-shadow))); }
  @media (prefers-reduced-motion: reduce) { .doodles :global(.doodle) { transition: none; animation: none; } }
</style>

<script>
  type Item = { src: string; ratio: number; kind: 'emoji' | 'pic'; mono: '' | 'dark' | 'light' };

  let stop: (() => void) | undefined;

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const randInt = (a: number, b: number) => Math.floor(rand(a, b + 1));

  function init() {
    stop?.();
    const box = document.querySelector<HTMLElement>('[data-doodles]');
    if (!box) return;
    let items: Item[] = [];
    try { items = JSON.parse(box.dataset.items ?? '[]'); } catch {}
    if (items.length < 6) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let bag: Item[] = [];
    let z = 1;
    let last: { x: number; y: number }[] = [];
    const live: HTMLImageElement[] = []; // newest last
    let timer = 0, visible = true;
    const starts: number[] = [];

    const draw = (): Item => {
      if (!bag.length) {
        bag = [...items].sort(() => Math.random() - 0.5);
        // the first of a fresh bag must not be one that is still on screen
        const onScreen = new Set(live.map((el) => el.dataset.src));
        const i = bag.findIndex((it) => !onScreen.has(it.src));
        if (i > 0) bag.unshift(...bag.splice(i, 1));
      }
      return bag.shift()!;
    };

    // spot: anywhere in the middle of the box, but away from the last two
    const spot = () => {
      let best = { x: 50, y: 50 }, bestD = -1;
      for (let i = 0; i < 8; i++) {
        const c = { x: rand(26, 74), y: rand(30, 70) };
        const d = Math.min(...last.map((p) => Math.hypot(p.x - c.x, p.y - c.y)), 99);
        if (d > bestD) { bestD = d; best = c; }
      }
      return best;
    };

    const restack = () => live.forEach((el, i) => { el.dataset.depth = String(live.length - 1 - i); });

    const add = (it: Item, instant = false) => {
      const el = document.createElement('img');
      el.className = 'doodle' + (instant ? '' : ' is-new');
      el.src = it.src; el.alt = ''; el.decoding = 'async'; el.draggable = false;
      el.dataset.src = it.src;
      if (it.mono) el.dataset.mono = it.mono;
      const { x, y } = spot();
      last = [{ x, y }, ...last].slice(0, 2);
      // emoji are small by nature, photos and screenshots bigger, wide ones widest; the rest is chance
      const base = it.kind === 'emoji' ? 36 : it.ratio > 1.6 ? 62 : 50;
      el.style.setProperty('--x', x.toFixed(1));
      el.style.setProperty('--y', y.toFixed(1));
      el.style.setProperty('--w', (base * rand(0.85, 1.2)).toFixed(1));
      el.style.setProperty('--r', ((Math.random() < 0.5 ? -1 : 1) * rand(2, 14)).toFixed(1));
      el.style.setProperty('--z', String(z++));
      el.style.setProperty('--fx', `${((Math.random() < 0.5 ? -1 : 1) * rand(2, 5)).toFixed(1)}px`);
      el.style.setProperty('--fy', `${((Math.random() < 0.5 ? -1 : 1) * rand(3, 6)).toFixed(1)}px`);
      el.style.setProperty('--fr', `${((Math.random() < 0.5 ? -1 : 1) * rand(0.6, 1.6)).toFixed(2)}deg`);
      el.style.setProperty('--fd', `${rand(5.5, 9).toFixed(1)}s`);
      el.style.setProperty('--fl', `${(-rand(0, 8)).toFixed(1)}s`);
      live.push(el);
      box.appendChild(el);
      restack();
      if (!instant) {
        const go = () => requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('is-new')));
        el.complete ? go() : (el.onload = go);
      }
    };

    const trim = () => {
      const target = randInt(3, 5);
      let removed = 0;
      while (live.length > target && removed < 2) {
        const old = live.shift()!;
        old.classList.add('is-gone');
        old.dataset.depth = '4';
        window.setTimeout(() => old.remove(), 500);
        removed++;
      }
      restack();
    };

    const step = () => { add(draw()); trim(); };

    // idle: after a pause without movement (or scroll) the stack calms down: the oldest pictures fade out
    // until two are left, and every few seconds one new picture still pops up, far less often than while the pointer moves
    const IDLE = 2600, IDLE_KEEP = 2, IDLE_EVERY: [number, number] = [3200, 5200];
    let idleT = 0, idleLoop = 0;
    const FADE = 1100;
    const sink = (el: HTMLImageElement, delay: number) => window.setTimeout(() => {
      el.classList.add('is-dissolving');
      window.setTimeout(() => el.remove(), FADE + 50);
    }, delay);
    const idleTick = () => {
      if (visible && !document.hidden) {
        add(draw());
        // the oldest leave one after the other, not all at once
        live.splice(0, Math.max(0, live.length - IDLE_KEEP)).forEach((el, i) => sink(el, i * 700));
        restack();
      }
      idleLoop = window.setTimeout(idleTick, rand(...IDLE_EVERY));
    };
    const poke = () => {
      window.clearTimeout(idleT); window.clearTimeout(idleLoop);
      idleT = window.setTimeout(idleTick, IDLE);
    };
    const mouse = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const scroll = !mouse && matchMedia('(min-width: 768px)').matches;
    const schedule = () => {
      timer = window.setTimeout(() => {
        if (visible && !document.hidden) step();
        schedule();
      }, rand(1400, 2600));
    };

    if (reduced) {
      for (let i = 0; i < 4; i++) add(draw(), true);
      stop = () => { box.replaceChildren(); stop = undefined; };
      return;
    }

    // first three land in quick succession; then the pointer (or, without one, a timer) takes over
    for (let i = 0; i < 3; i++) starts.push(window.setTimeout(() => add(draw()), 150 + i * 380));
    if (!mouse && !scroll) starts.push(window.setTimeout(schedule, 150 + 3 * 380));
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(box);

    // mouse: spawn by distance travelled over the stage
    const stage = box.closest<HTMLElement>('[data-hero]') ?? box; // the whole hero section, edge to edge
    const EVERY = 200, MIN_GAP = 160;
    let px = 0, py = 0, has = false, acc = 0, lastSpawn = 0;
    const onMove = (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;
      if (has) acc += Math.hypot(e.clientX - px, e.clientY - py);
      px = e.clientX; py = e.clientY; has = true;
      poke();
      const now = performance.now();
      if (acc >= EVERY && now - lastSpawn >= MIN_GAP) { acc = 0; lastSpawn = now; step(); }
    };
    const onLeave = () => { has = false; acc = 0; };

    let sy = scrollY, sacc = 0;
    const onScroll = () => {
      sacc += Math.abs(scrollY - sy); sy = scrollY;
      if (visible) poke();
      const now = performance.now();
      if (visible && sacc >= 120 && now - lastSpawn >= MIN_GAP) { sacc = 0; lastSpawn = now; step(); }
    };
    if (mouse || scroll) starts.push(window.setTimeout(poke, 150 + 3 * 380));
    if (scroll) addEventListener('scroll', onScroll, { passive: true });
    if (mouse) {
      stage.addEventListener('pointermove', onMove);
      stage.addEventListener('pointerleave', onLeave);
    }
    stop = () => {
      starts.forEach(clearTimeout); window.clearTimeout(timer); window.clearTimeout(idleT); window.clearTimeout(idleLoop); io.disconnect();
      removeEventListener('scroll', onScroll);
      stage.removeEventListener('pointermove', onMove); stage.removeEventListener('pointerleave', onLeave);
      box.replaceChildren(); stop = undefined;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
