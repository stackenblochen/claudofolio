---
/**
 * Home stage: doodles, screenshots and emoji that pop up on their own next to the headline, never over it. Every 2.5-4.5 s a new picture lands in the middle of
 * the box with a random tilt, as big as fits (its whole shape inside the box, with a margin for the tilt and the float); the previous one fades out.
 * The box is as high as the text block.
 * Spawning does not depend on the pointer; the only reaction is the bounce when the cursor touches the newest picture. From 992 px the box sits to the right of the text,
 * below that under it. Pictures come from src/assets/doodles/ (already optimised WebP, max 640 px); they are drawn from a shuffled bag, so none repeats
 * until all have been shown. Decorative only (aria-hidden). With reduced motion a static arrangement of three is shown.
 * Single-colour pictures follow the theme: black and white ones (BLACK / WHITE) are drawn in the strong text colour (white in dark mode, black in light mode)
 * through a mask, and the salmon marks the same way in the accent colour (ACCENT).
 */
/** Pictures shown at emoji size (emoji, plus any others listed here). */
const SMALL = new Set<string>([]);
/** Pictures shown a bit bigger than the rest. */
const BIG = new Set(['blob-gradient', 'crystal-cube', 'spotlight', 'wolfgang-black']);
const BLACK = new Set(['wl', 'wolfgang-black']);
const WHITE = new Set(['shape-white-a', 'shape-white-b']);
/** Flat one-colour marks, drawn through a mask in `--accent-primary` (the styleguide salmon, theme aware) instead of their own pixels. */
const ACCENT = new Set<string>([]);
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/doodles/*.webp', { eager: true });
const items = Object.entries(files).map(([path, mod]) => {
  const name = path.split('/').pop()!.replace('.webp', '');
  const { src, width, height } = mod.default;
  return {
    name,
    src,
    ratio: +(width / height).toFixed(3),
    accent: ACCENT.has(name),
    mono: BLACK.has(name) ? 'dark' : WHITE.has(name) ? 'light' : '',
  };
});
---

<div class="doodles" data-doodles data-items={JSON.stringify(items)} aria-hidden="true"></div>

<style>
  /* under the text; from 992 px beside it, a fixed-width box right next to the text (HomeHero centres the group). Neither the box nor the pictures react to the pointer. */
  .doodles { --doodle-shadow: 0.2; position: relative; width: 100%; height: 15rem; flex: none; user-select: none; }
  @media (min-width: 768px) { .doodles { height: 18rem; } }
  @media (min-width: 992px) { .doodles { flex: none; width: clamp(13rem, 22vw, 18rem); height: auto; align-self: stretch; } }
  :global(:root[data-theme='light']) .doodles { --doodle-shadow: 0.08; }
  .doodles :global(.doodle) {
    position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1%); object-fit: contain; height: auto;
    translate: -50% -50%;
    rotate: calc(var(--r) * 1deg);
    scale: calc(var(--s, 1) * (1 - var(--depth, 0) * 0.045));
    opacity: 0; z-index: var(--z, 1); pointer-events: none;
    transition: left 700ms cubic-bezier(0.34, 1.5, 0.64, 1), top 700ms cubic-bezier(0.34, 1.5, 0.64, 1), opacity 380ms ease, scale 520ms cubic-bezier(0.34, 1.4, 0.64, 1), rotate 520ms cubic-bezier(0.34, 1.4, 0.64, 1), translate 520ms cubic-bezier(0.34, 1.4, 0.64, 1);
    filter: drop-shadow(0 0.3rem 0.7rem rgb(0 0 0 / var(--doodle-shadow)));
    /* very subtle, endless float; amplitude, direction and speed are random per picture (set by JS) */
    animation: doodle-float var(--fd, 7s) ease-in-out var(--fl, 0s) infinite;
  }
  @keyframes doodle-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(var(--fx, 3px), var(--fy, -4px)) rotate(var(--fr, 1deg)); }
  }
  /* new picture: starts smaller, tilted the other way and slightly low, then springs into place */
  .doodles :global(.doodle.is-new) { scale: calc(var(--s, 1) * 0.7); rotate: calc(var(--r) * -0.6deg); translate: -50% -42%; transition: none; }
  /* every picture gets its depth (0 = newest) from the script: it gets fainter and smaller the further back it is, for any number of pictures (MAX) */
  .doodles :global(.doodle[data-depth]) { opacity: max(0.15, calc(1 - var(--depth, 0) * 0.28)); }
  .doodles :global(.doodle.is-gone) { opacity: 0; }
  /* accent marks: the picture's own pixels are pushed out of the box and the accent colour shows through the picture's shape instead */
  .doodles :global(.doodle.is-accent) {
    background: var(--accent-primary); object-position: 999px 999px; filter: none;
    -webkit-mask: var(--mask) center / contain no-repeat; mask: var(--mask) center / contain no-repeat;
  }
  /* single-colour black and white pictures work the same way, in the strong text colour (white in dark mode, black in light mode), so they follow the theme instantly */
  .doodles :global(.doodle.is-ink) {
    background: var(--text-strong); object-position: 999px 999px;
    -webkit-mask: var(--mask) center / contain no-repeat; mask: var(--mask) center / contain no-repeat;
  }
  @media (prefers-reduced-motion: reduce) { .doodles :global(.doodle) { transition: none; animation: none; } }
</style>

<script>
  type Item = { name: string; src: string; ratio: number; accent: boolean; mono: '' | 'dark' | 'light' };

  const START = 'wl'; // the picture that always comes first
  const MAX = 1; // pictures visible at once
  const FIT = 0.88; // share of the box a picture may fill: the rest is room for the tilt and the float
  const EVERY: [number, number] = [2500, 4500]; // ms between two new pictures (random in this range)

  let stop: (() => void) | undefined;

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  function init() {
    stop?.();
    const box = document.querySelector<HTMLElement>('[data-doodles]');
    if (!box) return;
    let items: Item[] = [];
    try { items = JSON.parse(box.dataset.items ?? '[]'); } catch {}
    if (items.length < 6) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let bag: Item[] = [];
    let z = 1;
    const live: HTMLImageElement[] = []; // newest last
    let timer = 0, visible = true;
    const starts: number[] = [];

    let first = true; // the very first picture is always the wl logo
    const draw = (): Item => {
      if (!bag.length) {
        bag = [...items].sort(() => Math.random() - 0.5);
        if (first) {
          const w = bag.findIndex((it) => it.name === START);
          if (w > 0) bag.unshift(...bag.splice(w, 1));
          first = false;
        }
        // the first of a fresh bag must not be one that is still on screen
        const onScreen = new Set(live.map((el) => el.dataset.src));
        const i = bag.findIndex((it) => !onScreen.has(it.src));
        if (i > 0) bag.unshift(...bag.splice(i, 1));
      }
      return bag.shift()!;
    };

    // the biggest width (in % of the box width) at which the whole picture still fits the box
    const fit = (ratio: number) => {
      const r = box.getBoundingClientRect();
      return Math.min(100, (r.height / Math.max(r.width, 1)) * ratio * 100) * FIT;
    };

    const setDepth = (el: HTMLElement, d: number) => { el.dataset.depth = String(d); el.style.setProperty('--depth', String(d)); };
    const restack = () => live.forEach((el, i) => setDepth(el, live.length - 1 - i));

    const add = (it: Item, instant = false) => {
      const el = document.createElement('img');
      el.className = 'doodle' + (instant ? '' : ' is-new') + (it.accent ? ' is-accent' : '') + (it.mono ? ' is-ink' : '');
      el.src = it.src; el.alt = ''; el.decoding = 'async'; el.draggable = false;
      el.dataset.src = it.src;
      if (it.mono) el.dataset.mono = it.mono;
      if (it.accent || it.mono) el.style.setProperty('--mask', `url("${it.src}")`);
      el.style.setProperty('--x', '50');
      el.style.setProperty('--y', '50');
      el.style.setProperty('--w', fit(it.ratio).toFixed(1));
      el.style.setProperty('--r', ((Math.random() < 0.5 ? -1 : 1) * rand(2, 10)).toFixed(1));
      el.style.setProperty('--z', String(z++));
      el.style.setProperty('--fx', `${((Math.random() < 0.5 ? -1 : 1) * rand(2, 5)).toFixed(1)}px`);
      el.style.setProperty('--fy', `${((Math.random() < 0.5 ? -1 : 1) * rand(3, 6)).toFixed(1)}px`);
      el.style.setProperty('--fr', `${((Math.random() < 0.5 ? -1 : 1) * rand(0.6, 1.6)).toFixed(2)}deg`);
      el.style.setProperty('--fd', `${rand(5.5, 9).toFixed(1)}s`);
      el.style.setProperty('--fl', `${(-rand(0, 8)).toFixed(1)}s`);
      live.push(el);
      box.appendChild(el);
      restack();
      if (!instant) {
        const go = () => requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('is-new')));
        el.complete ? go() : (el.onload = go);
      }
    };

    // never more than MAX at a time: the oldest fades out as a new one lands
    const trim = () => {
      while (live.length > MAX) {
        const old = live.shift()!;
        old.classList.add('is-gone');
        setDepth(old, MAX);
        window.setTimeout(() => old.remove(), 500);
      }
      restack();
    };

    // The old picture starts fading the moment the new one lands, so the new one must already be loaded and decoded, or the stage is empty for a moment
    const ready = (it: Item) => new Promise<void>((done) => {
      const im = new Image();
      im.src = it.src;
      im.decode().then(() => done(), () => done());
    });
    const step = () => {
      if (!visible || document.hidden) return; // paused: off screen or hidden tab
      const it = draw();
      ready(it).then(() => { add(it); trim(); });
    };
    const schedule = () => {
      timer = window.setTimeout(() => { step(); schedule(); }, rand(...EVERY));
    };

    if (reduced) {
      for (let i = 0; i < MAX; i++) add(draw(), true);
      stop = () => { box.replaceChildren(); stop = undefined; };
      return;
    }

    // the first ones land in quick succession, then the regular rhythm
    items.forEach((it) => { new Image().src = it.src; }); // warm the cache so later pictures are ready when their turn comes
    for (let i = 0; i < MAX; i++) starts.push(window.setTimeout(() => add(draw()), 150 + i * 380));
    starts.push(window.setTimeout(schedule, 150 + MAX * 380));
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(box);

    // bounce off: when the cursor touches the newest picture, it is knocked away from the cursor to a new spot (it stays inside the box, give or take a little),
    // turns, and its idle drift continues in the new direction
    let cool = 0;
    const touch = (e: PointerEvent) => {
      const el = live[live.length - 1];
      if (!el || el.classList.contains('is-new') || el.classList.contains('is-gone') || performance.now() < cool) return;
      const r = el.getBoundingClientRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      // inside the ellipse of the picture (the rectangle's corners are mostly empty)
      const nx = (e.clientX - cx) / (r.width / 2), ny = (e.clientY - cy) / (r.height / 2);
      if (nx * nx + ny * ny > 1) return;
      cool = performance.now() + 600;
      const len = Math.hypot(nx, ny) || 1, ux = -nx / len, uy = -ny / len; // away from the cursor
      const bx = box.getBoundingClientRect();
      const hw = (r.width / bx.width) * 50, hh = (r.height / bx.height) * 50; // half the picture, in % of the box
      const room = (half: number) => Math.max(0, 50 - half) + 6; // travel from the middle: until the picture touches the box edge, plus a little
      const x = Math.min(50 + room(hw), Math.max(50 - room(hw), +el.style.getPropertyValue('--x') + ux * 22));
      const y = Math.min(50 + room(hh), Math.max(50 - room(hh), +el.style.getPropertyValue('--y') + uy * 22));
      el.style.setProperty('--x', x.toFixed(1));
      el.style.setProperty('--y', y.toFixed(1));
      el.style.setProperty('--r', ((ux < 0 ? -1 : 1) * rand(4, 12)).toFixed(1));
      el.style.setProperty('--fx', `${(ux * rand(3, 6)).toFixed(1)}px`);
      el.style.setProperty('--fy', `${(uy * rand(3, 6)).toFixed(1)}px`);
    };
    if (!reduced) document.addEventListener('pointermove', touch, { passive: true });

    stop = () => {
      document.removeEventListener('pointermove', touch);
      starts.forEach(clearTimeout); window.clearTimeout(timer); io.disconnect();
      box.replaceChildren(); stop = undefined;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
