---
/**
 * I4 Before → after: "Then" card, red hand-drawn arrow overlapping both, "Now" card.
 * Either side can be a slot (`before`, `after`) instead of an image,
 * e.g. a <Mock>: it fills the whole card (no padding), use size="cover" (16:10) and set the card's background with the Mock's `stage`.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Arrow from './Arrow.astro';

interface Side { src: ImageMetadata | string; alt: string }
interface Props {
  before?: Side;
  after?: Side;
  beforeLabel?: string;
  afterLabel?: string;
  /** Show the "Then" / "Now" tags inside the cards. The labels stay as accessible names either way. */
  labels?: boolean;
  /** Arrow artwork between the cards (e.g. an imported SVG's `.src`). Falls back to the placeholder arrow. */
  arrow?: ImageMetadata | string;
}
const { before, after, beforeLabel = 'Then', afterLabel = 'Now', labels = true, arrow } = Astro.props;
const arrowSrc = arrow ? (typeof arrow === 'string' ? arrow : arrow.src) : undefined;
---

<div class="cmp measure-media reveal">
  <section class="card then" aria-label={beforeLabel}>
    {labels && <p class="tag t-label">{beforeLabel}</p>}
    <slot name="before">{before && <Img src={before.src} alt={before.alt} class="media-m" />}</slot>
  </section>
  <div class="arrow-slot"><Arrow class="arrow" src={arrowSrc} /></div>
  <section class="card now" aria-label={afterLabel}>
    {labels && <p class="tag t-label">{afterLabel}</p>}
    <slot name="after">{after && <Img src={after.src} alt={after.alt} class="media-m" />}</slot>
  </section>
</div>

<style>
  .cmp { position: relative; display: flex; flex-direction: column; gap: var(--space-5); }
  .card {
    border-radius: var(--radius-l); padding: var(--space-4); background: var(--bg-card);
    display: flex; flex-direction: column; gap: var(--space-3);
  }
  .tag { color: var(--text-strong); font-weight: var(--weight-emphasis); letter-spacing: var(--ls-emphasis); }
  .card :global(img) { width: 100%; }
  /* The arrow sits in a zero-height slot between the cards, centred on the gap, so it overlaps both cards and the gap between them is
     always the same (one gap), whatever the arrow's height. */
  .arrow-slot { position: relative; z-index: 2; height: 0; margin-block: calc(var(--space-5) * -0.5); }
  .arrow-slot :global(.arrow) { position: absolute; right: 12%; top: 0; transform: translateY(-50%); width: clamp(48px, 10%, 100px); }
  /* a mock fills the whole card, so its devices sit in the card exactly as they do on their own stage */
  .card:has(:global(.mock-fig)) { padding: 0; }
  @media (min-width: 768px) { .card { padding: var(--space-6) var(--space-4) var(--space-4) var(--space-5); } }
</style>
