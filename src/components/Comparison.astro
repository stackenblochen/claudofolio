---
/**
 * I4 Before → after: "Then" card, red hand-drawn arrow overlapping both, "Now" card.
 * `after` may carry a photographic background via `afterBackground`.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Arrow from './Arrow.astro';

interface Side { src: ImageMetadata | string; alt: string }
interface Props {
  before: Side;
  after: Side;
  beforeLabel?: string;
  afterLabel?: string;
  afterBackground?: ImageMetadata | string;
  /** Show the "Then" / "Now" tags inside the cards. The labels stay as accessible names either way. */
  labels?: boolean;
  /** Arrow artwork between the cards (e.g. an imported SVG's `.src`). Falls back to the placeholder arrow. */
  arrow?: ImageMetadata | string;
}
const { before, after, beforeLabel = 'Then', afterLabel = 'Now', afterBackground, labels = true, arrow } = Astro.props;
const arrowSrc = arrow ? (typeof arrow === 'string' ? arrow : arrow.src) : undefined;
const bg = afterBackground ? (typeof afterBackground === 'string' ? afterBackground : afterBackground.src) : undefined;
---

<div class="cmp measure-media reveal">
  <section class="card then" aria-label={beforeLabel}>
    {labels && <p class="tag t-label">{beforeLabel}</p>}
    <Img src={before.src} alt={before.alt} class="media-m" />
  </section>
  <Arrow class="arrow" src={arrowSrc} />
  <section class="card now" aria-label={afterLabel} style={bg ? `background-image:url("${bg}")` : undefined}>
    {labels && <p class="tag t-label">{afterLabel}</p>}
    <Img src={after.src} alt={after.alt} class="media-m" />
  </section>
</div>

<style>
  .cmp { position: relative; display: flex; flex-direction: column; gap: var(--space-5); }
  .card {
    border-radius: var(--radius-l); padding: var(--space-4); background: var(--bg-card) center / cover;
    display: flex; flex-direction: column; gap: var(--space-3);
  }
  .tag { color: var(--text-strong); font-weight: 700; }
  .card :global(img) { width: 100%; }
  .cmp :global(.arrow) {
    align-self: flex-end; margin-right: 12%; width: clamp(48px, 10%, 100px); margin-block: -60px; position: relative; z-index: 2;
  }
  @media (min-width: 768px) { .card { padding: var(--space-6) var(--space-4) var(--space-4) var(--space-5); } .cmp :global(.arrow) { margin-block: -100px; } }
</style>
