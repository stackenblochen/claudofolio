---
/**
 * Schema canvas: a diagram (structure, process, hierarchy, flow) drawn as live SVG, to sit in a `Diagram` with `fixed` (the stage gives it
 * its size and ratio). Text, lines and shapes are real SVG using the styleguide tokens, so they follow dark and light mode and stay sharp.
 * Rules and parts: docs/foundations/05-schemas.md.
 *
 *   <Diagram size="media" fixed>
 *     <Schema width={1400} height={810} alt="…">
 *       <SchemaGroup x={185} y={113} w={496} h={400} />
 *       <SchemaPill x={229} y={157} w={409} h={74} label="Code library" />
 *       <SchemaArrow points={[[433, 270], [433, 240]]} />
 *       <SchemaList x={813} y={152} title="…" items={['…']} />
 *     </Schema>
 *   </Diagram>
 *
 * Coordinates are in the viewBox (width × height, like a Figma frame). The drawing is scaled to fit the stage and centred.
 */
interface Props {
  /** viewBox size: the size of the drawing in the Figma frame. */
  width: number;
  height: number;
  /** Accessible description of the whole diagram (the drawing is exposed as one image). */
  alt: string;
}
const { width, height, alt } = Astro.props;
---

<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={alt} preserveAspectRatio="xMidYMid meet">
  <slot />
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
    /* diagram colours, all derived from the theme tokens */
    --schema-surface: var(--bg-tertiary);
    --schema-line: var(--border);
    --schema-text: var(--text-strong);
    --schema-text-dim: var(--text-default);
    --schema-accent: var(--accent-primary);
  }
</style>
