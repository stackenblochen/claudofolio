---
/**
 * L1/L2 Project teaser list (one teaser per row, media measure). Home: gap "wide" (60 px). Other projects: gap "tight" (30 px) under a dash + heading.
 * Feed it from getProjects() → toCard(); for "other projects" pass { exclude: current.id, limit: 2 }.
 */
import type { CardData } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  items: CardData[];
  gap?: 'wide' | 'tight';
}
const { items, gap = 'wide' } = Astro.props;
---

{items.length > 0
  ? (
    <ul class:list={['grid', 'measure-media', gap]} role="list">
      {items.map((c) => <li class="reveal"><ProjectCard card={c} /></li>)}
    </ul>
  )
  : <p class="t-body">New case studies are on their way.</p>}

<style>
  .grid { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-direction: column; }
  .wide { gap: var(--space-7); }
  .tight { gap: var(--space-5); }
</style>
