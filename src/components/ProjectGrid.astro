---
/**
 * L1/L2 Project grid. Home: gap "wide" (60 px). Other projects: gap "tight" (30 px) under a dash + heading.
 * Feed it from getProjects() → toCard(); for "other projects" pass { exclude: current.id, limit: 2 }.
 */
import type { CardData } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  items: CardData[];
  gap?: 'wide' | 'tight';
}
const { items, gap = 'wide' } = Astro.props;
---

{items.length > 0
  ? (
    <ul class:list={['grid', gap]} role="list">
      {items.map((c) => <li class="reveal"><ProjectCard card={c} /></li>)}
    </ul>
  )
  : <p class="t-body-l">New case studies are on their way.</p>}

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; align-items: start; }
  .wide { gap: var(--space-7) var(--space-7); }
  .tight { gap: var(--space-5); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
