---
/**
 * T6 Challenge / Solution. Takes the width of its parent: place it inside a text measure (Chapter body, SubChapter body). Slots: "challenge" and "solution" (body text).
 * Be honest about trade-offs: max one per chapter.
 */
---

<div class="cs stack" style="--stack-gap: var(--space-5)">
  <div class="block">
    <p class="label t-body"><span class="bullet neg" aria-hidden="true">●</span> Challenges</p>
    <div class="prose"><slot name="challenge" /></div>
  </div>
  <div class="block">
    <p class="label t-body"><span class="bullet pos" aria-hidden="true">►</span> Solution</p>
    <div class="prose"><slot name="solution" /></div>
  </div>
</div>

<style>
  .block { display: flex; flex-direction: column; gap: var(--space-3); }
  /* same as the titles in ImageText: body text in the strong colour, not bold */
  .label { color: var(--text-strong); }
  .bullet { display: inline-block; margin-right: 0.25em; }
  .neg { color: var(--accent-primary); }
  .pos { color: var(--accent-positive); }
</style>
