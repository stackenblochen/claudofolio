---
/**
 * I1 Wide figure: single image (diagram, screenshot) with optional caption, natural height.
 * size: "wide" = 10 cols (media measure), "text" = text measure, "full" = 12 cols.
 * kind: "screenshot" (default) = radius 12 + hairline + shadow, "appshot" = transparent PNG outline.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  size?: 'wide' | 'text' | 'full';
  kind?: 'screenshot' | 'appshot';
  loading?: 'lazy' | 'eager';
}
const { src, alt, caption, size = 'wide', kind = 'screenshot', loading } = Astro.props;
const measure = { wide: 'measure-media', text: 'measure-text', full: 'measure-wide' }[size];
const imgClass = {
  screenshot: 'media-m media-hairline media-shadow',
  appshot: 'app-shot',
}[kind];
---

<figure class={`${measure} reveal`}>
  <Img src={src} alt={alt} class={imgClass} loading={loading} />
  {caption && <figcaption class="t-caption caption">{caption}</figcaption>}
</figure>

<style>
  figure { display: flex; flex-direction: column; gap: var(--space-3); }
  img, :global(img) { width: 100%; }
</style>
