---
/** I2 Figure pair: two square images, 5 + 5 columns from 768 px, stacked below. */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Item { src: ImageMetadata | string; alt: string }
interface Props {
  a: Item;
  b: Item;
  caption?: string;
}
const { a, b, caption } = Astro.props;
---

<figure class="pair measure-media reveal">
  <div class="grid-12">
    <div class="span-6"><Img src={a.src} alt={a.alt} class="media-l" sizes="(min-width: 768px) 600px, 100vw" /></div>
    <div class="span-6"><Img src={b.src} alt={b.alt} class="media-l" sizes="(min-width: 768px) 600px, 100vw" /></div>
  </div>
  {caption && <figcaption class="t-caption">{caption}</figcaption>}
</figure>

<style>
  .pair { display: flex; flex-direction: column; gap: var(--space-3); }
  .pair :global(img) { width: 100%; }
</style>
