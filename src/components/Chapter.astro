---
/**
 * T4 Chapter: em-dash marker + heading + body, optional media below.
 * Semantic level is h2 by default (h1 once per page); the look is always heading-l.
 * Slots: default = body paragraphs, "media" = Figure / FigurePair / ScreenStack / Embed …
 */
interface Props {
  title: string;
  level?: 2 | 3;
  id?: string;
}
const { title, level = 2, id } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
const hasMedia = Astro.slots.has('media');
---

<section class="chapter" aria-labelledby={id}>
  <div class="container">
    <div class="measure-text reveal">
      <span class="dash t-heading" aria-hidden="true">—</span>
      <Tag class="t-heading" id={id}>{title}</Tag>
      {Astro.slots.has('default') && <div class="body prose"><slot /></div>}
    </div>
    {hasMedia && <div class="media"><slot name="media" /></div>}
  </div>
</section>

<style>
  .dash { display: block; color: var(--text-strong); line-height: 1; margin-bottom: var(--space-2); }
  .body { margin-top: var(--space-3); }
  .media { margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-6); }
  @media (min-width: 1230px) { .body { padding-right: var(--space-6); } }
</style>
