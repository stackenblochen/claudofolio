---
/** G1/G2 Site header: wordmark left, text menu right, overlay menu below 768 px. */
import { NAV, SITE, url } from '../lib/site';
import logoSvg from '../assets/wolfgang-logo.svg?raw';
import ThemeSwitch from './ThemeSwitch.astro';

// Inline so it can follow currentColor; decorative, the link carries the accessible name.
const logo = logoSvg.replace(/fill="white"/g, 'fill="currentColor"').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

interface Props {
  current?: string;
}
const { current } = Astro.props;

const items = [
  ...NAV.map((n) => ({ ...n, href: url(n.href) })),
  ...(SITE.email ? [{ label: 'Contact', href: `mailto:${SITE.email}` }] : []),
];
---

<header class="site-header" data-site-header>
  <div class="container bar">
    <a class="logo" href={url('/')} aria-label={`${SITE.name}, home`} set:html={logo} />

    <div class="right">
      <nav class="menu" aria-label="Main">
        <ul role="list">
          {items.map((i) => (
            <li><a class="t-body" href={i.href} aria-current={current === i.label ? 'page' : undefined}>{i.label}</a></li>
          ))}
        </ul>
      </nav>
      <ThemeSwitch />
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="overlay-menu" data-burger>
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="overlay" id="overlay-menu" hidden data-overlay>
    <nav aria-label="Main (overlay)">
      <ul role="list">
        {items.map((i) => <li><a class="t-heading" href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <ThemeSwitch variant="tabs" />
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    height: var(--header-h);
    margin-bottom: calc(var(--header-h) * -1); /* floats over the hero */
  }
  .site-header[data-on-dark] { color-scheme: dark; } /* set by CaseHero while a dark backdrop hero is under the header */
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 3; }
  .logo { display: block; width: 100px; color: var(--text-strong); line-height: 0; }
  .logo :global(svg) { width: 100%; height: auto; }
  @media (min-width: 768px) { .logo { width: 140px; } }
  .right { display: none; align-items: center; gap: var(--space-6); }
  .menu ul { display: flex; gap: var(--space-6); padding: 0; margin: 0; list-style: none; }
  .menu a {
    color: var(--text-default); text-decoration: none; padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }
  .menu a:hover, .menu a[aria-current='page'] { color: var(--text-strong); border-bottom-color: var(--accent-primary); }
  .burger { background: none; border: 0; padding: var(--space-3) 0 var(--space-3) var(--space-3); cursor: pointer; }
  .bars, .bars::before { display: block; width: 24px; height: 2px; background: var(--text-default); }
  .bars { position: relative; margin-block: 6px; }
  .bars::before { content: ''; position: absolute; top: -6px; left: 0; box-shadow: 0 12px 0 var(--text-default); }
  .burger[aria-expanded='true'] .bars { background: transparent; }
  .burger[aria-expanded='true'] .bars::before { top: 0; box-shadow: none; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .bars::after {
    content: ''; position: absolute; top: 0; left: 0; width: 24px; height: 2px; background: var(--text-default); transform: rotate(-45deg);
  }
  .overlay {
    position: fixed; inset: 0; z-index: 1; background: var(--overlay-menu);
    display: flex; flex-direction: column; gap: var(--space-7); align-items: center; justify-content: center; text-align: center;
  }
  .overlay[hidden] { display: none; }
  .overlay ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-5); }
  .overlay a { text-decoration: none; }

  @media (min-width: 768px) {
    .right { display: flex; }
    .burger, .overlay { display: none; }
  }
</style>

<script>
  // Runs on first load and after every view-transition navigation (the header is swapped each time).
  let ac: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const overlay = document.querySelector<HTMLElement>('[data-overlay]');

    const setOpen = (open: boolean) => {
      if (!burger || !overlay) return;
      burger.setAttribute('aria-expanded', String(open));
      overlay.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    setOpen(false);
    burger?.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'), { signal });
    overlay?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); }, { signal });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); }, { signal });

    // While a dark backdrop hero (CaseHero) is under the header, the header resolves its colours as dark, so the logo and menu
    // stay light in light mode too. The hero is looked up on every call: protected pages only insert it after decryption,
    // and scripts inside the encrypted content do not run, so this has to live here.
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const syncOnDark = () => {
      const hero = document.querySelector<HTMLElement>('.hero.backdrop');
      header?.toggleAttribute('data-on-dark', !!hero && hero.getBoundingClientRect().bottom > (header?.offsetHeight ?? 0) / 2);
    };
    window.addEventListener('scroll', syncOnDark, { passive: true, signal });
    window.addEventListener('resize', syncOnDark, { signal });
    const main = document.getElementById('main');
    if (main) new MutationObserver(syncOnDark).observe(main, { childList: true, subtree: true });
    syncOnDark();
  });
</script>
