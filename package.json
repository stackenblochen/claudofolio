{
  "name": "claudofolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:release": "SITE_TARGET=production astro build && rm -rf release/portfolio/styleguide && cp tools/release-index.html release/index.html",
    "deploy": "node --env-file=.env tools/deploy.mjs",
    "deploy:dry": "node --env-file=.env tools/deploy.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tabler/icons": "^3.49.0",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "basic-ftp": "^6.2.3"
  }
}
